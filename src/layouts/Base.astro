---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { author, site } from '../config/site';
import { absoluteUrl, href, sitePath } from '../lib/url';
import { websiteJsonLd, type PageMeta, isPreview, urlOf } from '../modules/website';
import { siteGraph } from '../modules/website/site-graph';

type Props = PageMeta;
const {
  title,
  description = site.description,
  noindex = false,
  image: imagePath = '/og/site.jpg',
  jsonLd: pageLd = [],
} = Astro.props;
// Absolute URLs are on the canonical host from both deploy targets: the mirror's pages point at commonwealthofreason.com.
const canonical = absoluteUrl(sitePath(Astro.url.pathname));
// Social image: the brand kit's share card (1200x675), the Commonwealth's unless the page belongs to an institution.
const image = absoluteUrl(imagePath);
const imageAlt = title === site.name ? site.name : `${title} - ${site.name}`;
// JSON-LD sits in a <script>: escape < so no value can close the tag.
const jsonLd = [websiteJsonLd(), ...pageLd].map((x) => JSON.stringify(x).replaceAll('<', '\\u003c'));
// Dev server only: a page injected by astro.config.mjs (src/admin) is framed in pink; so is any link to one and any
// `.dev-only` section on a public page. A build renders none of it.
const dev = import.meta.env.DEV;
// A preview matter (packaged, not live: the dev server's view of the site graph) counts as a dev-only page too.
const graph = dev ? siteGraph() : null;
const previews = graph
  ? [...graph.nodes.entries()]
      .filter(([id, n]) => n.kind === 'story' && isPreview(graph, id))
      .map(([id]) => urlOf(graph, id))
      .filter((u): u is string => !!u)
      .map((u) => href(u))
  : [];
const devPage =
  dev &&
  (/^\/(admin|\[topic\]\/(stories|register|scripts|review))/.test(Astro.routePattern) ||
    previews.includes(Astro.url.pathname));
const devLinks = [
  ...['/admin', '/stories/', '/register/', '/scripts/', '/review/', '/review-'].map(
    (p) => `a[href^="/"][href*="${p}"]`,
  ),
  ...previews.map((p) => `a[href^="${p}"]`),
];
const devCss = `body[data-dev-page]::after { content: ''; position: fixed; inset: 0; z-index: 9999; pointer-events: none; border: 4px solid #ff2d95; }
.dev-only, ${devLinks.join(', ')} { outline: 2px solid #ff2d95; outline-offset: 2px; }`;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9f6ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#172a45" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    {/* A noindex page makes no canonical claim: 404.html has no URL of its own to point at. */}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="author" content={author.name} />
    {/* eslint-disable-next-line astro/no-set-html-directive -- JSON-LD from site config, with < escaped */}
    {!noindex && jsonLd.map((x) => <script is:inline type="application/ld+json" set:html={x} />)}

    <!-- Theme: applied before paint to avoid a flash. Order: user override → system preference. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('theme'); // throws when storage is blocked (e.g. Safari with cookies off)
        } catch {
          /* storage blocked: fall through to the system preference */
        }
        root.classList.toggle(
          'dark',
          stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches),
        );
        root.dataset.theme = stored === 'light' || stored === 'dark' ? stored : 'system';
        // Print in light theme: the dark palette is unreadable on paper. Restore whatever the class was at print
        // time (the toggle keeps it current), not the load-time preference.
        let wasDark;
        addEventListener('beforeprint', () => {
          wasDark = root.classList.contains('dark');
          root.classList.remove('dark');
        });
        addEventListener('afterprint', () => root.classList.toggle('dark', wasDark));
      })();
    </script>
    {/* eslint-disable-next-line astro/no-set-html-directive -- a constant stylesheet, dev server only */}
    {dev && <style is:inline set:html={devCss} />}
  </head>
  <body class="flex min-h-svh flex-col" data-dev-page={devPage || undefined}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:border focus:bg-background focus:px-3 focus:py-2 focus:text-foreground print:hidden"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main
      id="main"
      class="mx-auto grid w-full max-w-wide flex-1 grid-cols-[minmax(0,1fr)] gap-10 px-4 py-10 sm:px-6 md:py-14"
    >
      <slot />
    </main>
    <SiteFooter />

    <!-- Back to top, as on the blog: shown once the page is scrolled past 400px. -->
    <button
      type="button"
      id="back-to-top"
      aria-label="Back to top"
      hidden
      class="fixed right-4 bottom-4 z-20 cursor-pointer rounded-full border bg-card p-3 text-muted-foreground shadow-md hover:text-foreground print:hidden"
    >
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M10 16V4M4 10l6-6 6 6"></path>
      </svg>
    </button>
    <script is:inline>
      {
        const toTop = document.getElementById('back-to-top');
        addEventListener('scroll', () => (toTop.hidden = scrollY < 400), { passive: true });
        toTop.addEventListener('click', () =>
          scrollTo({
            top: 0,
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          }),
        );
      }
    </script>
  </body>
</html>
