---
// The front page of the Record: settled matters in the one order of every list (a live video first), then the
// institutions.
// The full directory is /institutions/. A topic no institution claims is not listed (publicTopicNames).
import Base from '../layouts/Base.astro';
import LabelStrip from '../components/LabelStrip.astro';
import { commissionKey, commissions, site } from '../config/site';
import { labelCounts } from '../lib/finding-label';
import { ROOT } from '../shared/io';
import { hasVideo, matterOrder, matterPath } from '../modules/website';
import { siteGraph } from '../modules/website/site-graph';
import KindIcon from '../components/KindIcon.astro';
import SourceIcons from '../components/SourceIcons.astro';
import { storyUrlSlug } from '../lib/stories';
import { loadTopic } from '../lib/topics';
import { href } from '../lib/url';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const LATEST = 6;
const graph = siteGraph();
const latest = [...graph.nodes.values()]
  .filter((n) => n.kind === 'story' && n.public && !graph.stories.get(n.id)!.partOf)
  .sort((a, b) => matterOrder(graph, a, b))
  .slice(0, LATEST)
  .map((n) => {
    const s = graph.stories.get(n.id)!;
    const t = loadTopic(n.topic!);
    const path = matterPath(t.name, s);
    const card = `/og/stories/${t.name}/${storyUrlSlug(s)}.jpg`;
    const claims = t.claims.filter((c) => s.claims.includes(c.id));
    return {
      s,
      t,
      path,
      card: existsSync(join(ROOT, 'public', card)) ? card : null,
      counts: labelCounts(claims),
      video: hasVideo(graph, n.id),
    };
  });
---

<Base title={site.name}>
  <SourceIcons />
  <header class="grid gap-3 border-b pb-8">
    <div class="eyebrow text-muted-foreground">{site.publicRecord}</div>
    <h1 class="text-display font-bold">{site.name}</h1>
    <p class="max-w-prose text-lg">
      The commissions, bureaus and offices of the Commonwealth give everyday questions the full weight of a public
      inquiry: whether a heat pump saves money, whether a get-rich-quick plan ever pays, whether a health claim survives
      the studies. Every inquiry collects what videos and posts claim, pulls out the distinct claims, and judges each
      against the best evidence available.
    </p>
    <p class="max-w-prose text-sm text-muted-foreground">
      Each verdict links to the quote it judges and the lines of evidence it rests on, so the checking can be checked.{
        ' '
      }
      <a href={href('/about/')}>How an inquiry is built.</a>
    </p>
  </header>

  <section aria-labelledby="latest">
    <h2 class="mb-4 text-featured font-bold" id="latest">Latest findings</h2>
    {latest.length === 0 && <p class="text-muted-foreground">No findings published yet.</p>}
    <ul class="grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        latest.map(({ s, t, path, card, counts, video }) => (
          <li class="grid content-start gap-2 rounded-lg border bg-card p-4 text-card-foreground">
            {card && <img class="w-full rounded-sm" src={href(card)} alt="" width="1200" height="675" loading="lazy" />}
            <span class="eyebrow text-muted-foreground">{t.label}</span>
            <a class="font-heading text-title font-bold" href={href(path)}>
              {s.title}
            </a>
            <span class="text-sm text-muted-foreground">{s.question}</span>
            {video && (
              <span class="inline-flex items-center gap-1 eyebrow">
                <KindIcon kind="video" decorative />
                Video
              </span>
            )}
            <p class="text-sm">{s.arc.resolution}</p>
            <LabelStrip counts={counts} base={`${href(path)}#evidence-`} />
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="institutions">
    <h2 class="mb-3 text-featured font-bold" id="institutions">Institutions</h2>
    <ul class="grid list-none gap-1.5 p-0">
      {
        Object.values(commissions).map((c) => (
          <li>
            <a href={href(`/commissions/${commissionKey(c)}/`)}>{c.ceremonialName}</a>
          </li>
        ))
      }
    </ul>
    <p class="mt-3"><a href={href('/institutions/')}>The full directory</a></p>
  </section>
</Base>
