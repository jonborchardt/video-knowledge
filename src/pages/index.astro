---
// The Official Public Record: one card per institution of the Commonwealth, with the inquiries it has published and a
// featured story. A topic no institution claims is not listed (publicTopicNames); an institution without a channel
// says so rather than inventing a handle.
import Base from '../layouts/Base.astro';
import { commissionKey, commissions, site } from '../config/site';
import { loadStories } from '../lib/stories';
import { storyUrlSlug } from '../lib/stories';
import { loadTopic, publicTopicNames } from '../lib/topics';
import { href } from '../lib/url';

const names = new Set(publicTopicNames());
const topics = new Map([...names].map((n) => [n, loadTopic(n)]));
const institutions = Object.values(commissions).map((c) => {
  const published = c.topics.filter((n) => names.has(n)).map((n) => topics.get(n)!);
  // Featured: the best-ranked ready story across the institution's inquiries. A decision story is a recap group on
  // the topic page, so it deep-links to that group; any other story lands on the inquiry.
  const featured = published
    .flatMap((t) => (loadStories(t.name)?.stories ?? []).map((s) => ({ s, t })))
    .find(({ s }) => s.readiness === 'ready');
  const link = featured ? href(`/${featured.t.name}/${storyUrlSlug(featured.s)}/`) : null;
  return { c, published, featured, link };
});
const fmt = (n: number) => n.toLocaleString('en-US');
---

<Base title={site.name}>
  <header class="grid gap-3 border-b pb-8">
    <div class="eyebrow text-muted-foreground">{site.publicRecord}</div>
    <h1 class="text-display font-bold">{site.name}</h1>
    <p class="max-w-prose text-lg">
      The commissions, bureaus and offices of the Commonwealth give everyday questions the full weight of a public
      inquiry: whether a heat pump saves money, whether a get-rich-quick plan ever pays, whether a health claim survives
      the studies. Every inquiry collects what videos and posts claim, pulls out the distinct claims, and judges each
      against the best evidence available.
    </p>
    <p class="max-w-prose text-sm text-muted-foreground">
      Each verdict links to the quote it judges and the lines of evidence it rests on, so the checking can be checked.{
        ' '
      }
      <a href={href('/about/')}>How an inquiry is built.</a>
    </p>
  </header>

  <section class="grid gap-6" aria-label="Institutions">
    {
      institutions.map(({ c, published, featured, link }) => (
        <article class="grid gap-4 rounded-lg border bg-card p-5 text-card-foreground sm:p-6">
          <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
            <div class="flex items-center gap-4">
              <img
                class="size-14 shrink-0"
                src={href(`/commissions/${commissionKey(c)}.png`)}
                alt=""
                width="256"
                height="256"
              />
              <div>
                <div class="eyebrow text-muted-foreground">
                  {site.name} · {c.ceremonialName !== c.name ? c.ceremonialName : 'Institution'}
                </div>
                <h2 class="mt-1 text-featured font-bold">
                  <a class="no-underline hover:underline" href={href(`/commissions/${commissionKey(c)}/`)}>
                    {c.name}
                  </a>
                </h2>
              </div>
            </div>
            {c.youtube ? (
              <a href={c.youtube} rel="me" class="text-sm" title={c.fullName}>
                YouTube {c.handle}
              </a>
            ) : (
              <span class="rounded-sm border border-dashed px-2 py-1 eyebrow text-muted-foreground">
                Channel coming soon
              </span>
            )}
          </header>
          <p class="max-w-prose text-muted-foreground">{c.remit}</p>
          {published.length > 0 ? (
            <div class="grid gap-4 md:grid-cols-[2fr_3fr]">
              <ul class="grid list-none gap-2 p-0">
                {published.map((t) => (
                  <li>
                    <a
                      class="grid grid-cols-[auto_1fr] items-start gap-3 rounded-md border bg-background p-3 no-underline hover:border-primary"
                      href={href(`/${t.name}/`)}
                    >
                      {t.glyph && <span class="size-9 text-primary [&>svg]:size-full" set:html={t.glyph} />}
                      <span class="grid gap-0.5">
                        <span class="font-heading font-bold text-primary">{t.label}</span>
                        <span class="font-mono text-xs text-muted-foreground">
                          {fmt(t.counted)} sources · {fmt(t.claims.length)} claims · {t.studies} studies
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              {featured && link && (
                <a
                  class="grid content-start gap-2 rounded-md border border-dashed p-4 no-underline hover:border-primary"
                  href={link}
                >
                  <span class="eyebrow text-muted-foreground">Featured inquiry · {featured.t.label}</span>
                  <span class="font-heading text-title font-bold">{featured.s.title}</span>
                  <span class="text-sm text-muted-foreground">{featured.s.question}</span>
                  <span class="text-sm text-primary">Read the findings</span>
                </a>
              )}
            </div>
          ) : (
            <p class="font-mono text-xs text-muted-foreground">No inquiry published yet.</p>
          )}
        </article>
      ))
    }
  </section>
</Base>
