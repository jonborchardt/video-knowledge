---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { loadTopic, topicNames } from '../lib/topics';
import { href } from '../lib/url';

const topics = topicNames().map(loadTopic);
const firstSentence = (s: string) => s[0].toUpperCase() + s.slice(1).split('. ')[0] + '.';
---

<Base title={site.name}>
  <header>
    <div class="eyebrow text-muted-foreground">{site.name}</div>
    <h1 class="mt-1 text-display font-semibold">What videos and posts claim, checked against the evidence</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      Each subject collects YouTube videos and blog posts, extracts the claims they make, and judges every claim: first
      by an AI guess, then against studies where they exist. Pick a subject.
    </p>
  </header>
  <section class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-4">
    {
      topics.map((t) => (
        <a
          class="grid gap-2 rounded-lg border bg-card p-4 text-card-foreground no-underline hover:border-primary"
          href={href(`/${t.name}/`)}
        >
          <h2 class="text-title font-semibold text-primary">{t.label}</h2>
          <span class="font-mono text-xs text-muted-foreground">
            {t.counted} sources · {t.claims.length} claims · {t.studies} studies
          </span>
          {t.bottomLine && <span class="text-sm text-muted-foreground">{firstSentence(t.bottomLine)}</span>}
        </a>
      ))
    }
    <div
      class="grid gap-2 rounded-lg border border-dashed bg-card p-4 text-card-foreground opacity-70"
      aria-disabled="true"
    >
      <h2 class="text-title font-semibold text-muted-foreground">More topics</h2>
      <span class="font-mono text-xs text-muted-foreground">coming soon</span>
    </div>
    {
      topics.length === 0 && (
        <p class="text-sm text-muted-foreground">No subjects have a report yet. Run npm run report.</p>
      )
    }
  </section>
</Base>
