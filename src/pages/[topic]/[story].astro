---
// One matter before an institution: a story from topics/<topic>/stories.json as its own page. The viewer-facing
// parts of the candidate (title, question, tension, premise, takeaway) and the claims it turns on, each with its
// verdict and sources from the inquiry. A chain lists its follow-up questions; a follow-up points at its first question.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import ClaimCard from '../../components/ClaimCard.astro';
import ReportHeader from '../../components/ReportHeader.astro';
import LabelStrip from '../../components/LabelStrip.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import HeatingCost from '../../components/tools/HeatingCost.astro';
import MatterList from '../../components/MatterList.astro';
import NextSteps from '../../components/NextSteps.astro';
import { loadCta, resolveCtas } from '../../lib/cta';
import { isPreview, matterItem, matterPath, related, storyNode } from '../../lib/content-graph';
import { siteGraph } from '../../lib/site-graph';
import { toolOf } from '../../tools';
import { articleModified, loadArticleRelease } from '../../lib/article';
import { articleView, type FigureDraw } from '../../lib/article-view';
import { chartProblems, datasetChart } from '../../lib/chart-geometry';
import { dataRef, loadDatasets } from '../../lib/datasets';
import { reviewMediaHref } from '../../lib/review-view';
import { FILES, storySlug } from '../../lib/script';
import type { Storyboard } from '../../lib/storyboard';
import { storyOutputs } from '../../lib/outputs';
import { articleJsonLd, breadcrumbJsonLd, videoJsonLd } from '../../lib/seo';
import { loadPublicRecord, revisionLine } from '../../lib/public-record';
import { FINDING_LABELS, FINDING_TEXT, findingLabel, labelCounts } from '../../lib/finding-label';
import SourceIcons from '../../components/SourceIcons.astro';
import SourceLink from '../../components/SourceLink.astro';
import Stamp from '../../components/Stamp.astro';
import { commissionBody, commissionKey, commissionOf, site } from '../../config/site';
import { loadStories, type Story, storyUrlSlug } from '../../lib/stories';
import { loadTopic, publicTopicNames, type Topic } from '../../lib/topics';
import { readJson, ROOT, topicDir } from '../../lib/io';
import { citeLabel, datasetSource, href } from '../../lib/url';

export function getStaticPaths() {
  const g = siteGraph();
  return publicTopicNames().flatMap((name) => {
    const t = loadTopic(name);
    const stories = loadStories(name)?.stories ?? [];
    return stories
      .filter((s) => g.nodes.get(storyNode(name, s.id))?.public)
      .map((s) => ({ params: { topic: name, story: storyUrlSlug(s) }, props: { t, s, stories } }));
  });
}
const { t, s, stories } = Astro.props as { t: Topic; s: Story; stories: Story[] };
const commission = commissionOf(t.name)!;
const byId = new Map(stories.map((x) => [x.id, x]));
const first = s.partOf ? byId.get(s.partOf) : undefined;
const claims = s.claims.map((id) => t.claims.find((c) => c.id === id)).filter((c) => !!c);
const groups = FINDING_LABELS.map((label) => ({
  label,
  claims: claims.filter((c) => findingLabel(c) === label),
})).filter((g) => g.claims.length);
// The sources this matter rests on: every source that asserts or denies one of its claims, by exhibit number.
const exhibitIds = new Set(claims.flatMap((c) => c.sources.map((x) => x.id)));
// A preview (dev server) also lists sources without a number yet, last.
const exhibits = t.sources
  .filter((x) => exhibitIds.has(x.id) && (x.exhibit || import.meta.env.DEV))
  .sort((a, b) => (a.exhibit ?? Infinity) - (b.exhibit ?? Infinity));
const revisions = claims
  .flatMap((c) => c.revisions.map((r) => ({ r, text: c.text })))
  .sort((a, b) => a.r.at.localeCompare(b.r.at));
const revised = revisions.at(-1)?.r.at ?? null;
// The video lives on the first question's page; a follow-up links to it.
const outputs = storyOutputs(t.name, s.partOf ?? s.id);
// The story's own share card (npm run brand), else its institution's.
const card = `/og/stories/${t.name}/${storyUrlSlug(s)}.jpg`;
const image = existsSync(join(ROOT, 'public', card)) ? card : `/og/${commissionKey(commission)}.jpg`;
const path = matterPath(t.name, s);
// The released companion article, each figure drawn from its storyboard chart ('<story slug>/<scene id>') or
// evidence dataset ('data:<topic>/<id>'). A follow-up links to its first question's article, so the two pages never share a title.
const release = first ? null : loadArticleRelease(t.name, s.id);
const firstArticle = !!first && !!loadArticleRelease(t.name, first.id);
const figures = new Map<string, FigureDraw>();
// "Document name, lines 10-24" for each distinct passage a figure's points cite.
const sourceOf = (cites: string[]) => [...new Set(cites)].map((c) => citeLabel(t.docNames, c)).join('; ');
const datasets = loadDatasets(t.name);
for (const b of release?.article.sections.flatMap((x) => x.blocks) ?? []) {
  if (b.kind !== 'figure') continue;
  const table = datasets.find((d) => dataRef(t.name, d.id) === b.ref);
  if (table) {
    const chart = datasetChart(table);
    const problems = chart ? chartProblems(chart) : [];
    if (problems.length) throw new Error(`figure ${b.ref}: ${problems.join('; ')}`);
    figures.set(b.ref, {
      table,
      ...(chart && { chart }),
      source: datasetSource(
        t.docNames,
        table.rows.flatMap((r) => r.cells.map((c) => c.cite)),
        table.asOf,
      ),
    });
    continue;
  }
  const [slug, scene] = b.ref.split('/');
  const sb = readJson<Storyboard>(join(topicDir(t.name), 'scripts', slug, FILES.storyboard));
  const chart = sb?.scenes.find((x) => x.id === scene)?.visual.chart;
  if (!chart) continue;
  const problems = chartProblems(chart);
  if (problems.length) throw new Error(`figure ${b.ref}: ${problems.join('; ')}`);
  figures.set(b.ref, { chart, source: sourceOf(chart.points.map((p) => p.cite)) });
}
const view = release && articleView(release, t, loadPublicRecord(t.name), site.repo, figures);
const meta = release?.article.meta;
const jsonLd = [
  articleJsonLd({
    headline: meta?.headline ?? s.title,
    description: meta?.description.text ?? s.question,
    path,
    image,
    series: commission.fullName,
    datePublished: outputs.video?.publishedAt,
    dateModified: (release && articleModified(release)) ?? revised ?? undefined,
  }),
  ...(outputs.video && !first ? [videoJsonLd(outputs.video, s.question, image)] : []),
  breadcrumbJsonLd([
    { name: site.name, path: '/' },
    { name: commission.name, path: `/commissions/${commissionKey(commission)}/` },
    { name: t.label, path: `/${t.name}/` },
    { name: s.title, path },
  ]),
];
const storyHref = (x: Pick<Story, 'id'>) => href(matterPath(t.name, x));
const body = commissionBody(commission);
const h2 = 'mb-3 text-featured font-bold';
// A story's calculator (src/tools); an id without a component here fails the build.
const tool = toolOf(t.name, s.id);
if (tool && tool.id !== 'heating-cost') throw new Error(`tool ${tool.id}: no component on the matter page`);
const graph = siteGraph();
const node = storyNode(t.name, s.id);
const preview = isPreview(graph, node);
const rootId = s.partOf ?? s.id;
// The calls to action of a ready first question (a follow-up's live on its first question's video); a file error
// fails the build.
const ctaFile = loadCta(t.name, s.id);
const ctas = !first ? resolveCtas(ctaFile, graph, node) : null;
if (ctas?.problems.length) throw new Error(`${t.name}/${s.id} cta.json: ${ctas.problems.join('; ')}`);
const relatedItems = related(graph, node, ctaFile?.related ?? {}).map((n) => matterItem(graph, n.id));
---

<Base
  title={`${meta?.seoTitle ?? s.title} · ${commission.name}`}
  description={meta?.description.text ?? s.question}
  image={image}
  jsonLd={jsonLd}
>
  <SourceIcons />
  {
    preview && (
      <p class="dev-only mx-auto max-w-wide p-2 text-sm font-semibold">
        Preview: not live. <a href={href(`/${t.name}/review/${storySlug(rootId)}`)}>Review</a>
      </p>
    )
  }
  <ReportHeader
    brand={commissionKey(commission)}
    kind="Matter"
    trail={[
      { label: site.name, href: href('/') },
      { label: commission.ceremonialName, href: href(`/commissions/${commissionKey(commission)}/`) },
      { label: t.label, href: href(`/${t.name}/`) },
    ]}
    title={s.title}
    lede={s.question}
    revised={revised}
    facts={[
      { term: 'Inquiry', value: t.label, href: href(`/${t.name}/`), kind: 'inquiry' },
      { term: 'Published by', value: commission.fullName },
      { term: 'Claims', value: `${claims.length} examined` },
      {
        term: 'Status',
        value: 'Evidence verified and reviewed; the verdicts below say how far it reaches',
      },
    ]}
  >
    {
      first && (
        <p class="text-sm text-muted-foreground">
          A follow-up question to <a href={storyHref(first)}>{first.title}</a>.
        </p>
      )
    }
  </ReportHeader>

  <section id="answer" aria-labelledby="answer-title">
    <div class="eyebrow text-gold">The answer</div>
    <h2 class={h2} id="answer-title">What the Record finds</h2>
    <p class="max-w-prose font-heading text-[1.05rem] leading-relaxed">
      {s.arc.resolution}
    </p>
    <div class="mt-3">
      <LabelStrip counts={labelCounts(claims)} base="#evidence-" />
    </div>
  </section>

  {
    preview && !first && (
      <section class="dev-only" aria-label="The video">
        <video controls preload="none" src={reviewMediaHref(t.name, storySlug(rootId))} class="w-full" />
      </section>
    )
  }

  {
    outputs.video &&
      (first ? (
        <p>
          The video answering this question is on <a href={`${storyHref(first)}#video`}>{first.title}</a>.
        </p>
      ) : (
        <section aria-label="The video">
          <VideoEmbed video={outputs.video} poster={image} shorts={outputs.shorts} />
        </section>
      ))
  }

  {
    ctas && (
      <section aria-labelledby="next">
        <div class="eyebrow text-gold">Next</div>
        <h2 class={h2} id="next">
          Where to go from here
        </h2>
        <NextSteps ctas={ctas} path={path} />
      </section>
    )
  }

  <section id="article">
    {
      firstArticle && (
        <p>
          The article answering this question is on <a href={`${storyHref(first!)}#article`}>{first!.title}</a>.
        </p>
      )
    }
    {
      view ? (
        <ArticleBody view={view} dataHref={datasets.length ? href(`/${t.name}/data/`) : undefined} />
      ) : (
        <>
          <section aria-labelledby="dispute">
            <div class="eyebrow text-gold">Section I</div>
            <h2 class={h2} id="dispute">
              The dispute
            </h2>
            <p class="max-w-prose">{s.tension}</p>
          </section>

          <section aria-labelledby="evidence">
            <div class="eyebrow text-gold">Section II</div>
            <h2 class={h2} id="evidence">
              What the evidence shows
            </h2>
            <p class="max-w-prose">{s.premise}</p>
            {s.arc.takeaway && (
              <figure class="mt-4 max-w-wide border-l-4 border-gold bg-card p-4 pl-5">
                <figcaption class="eyebrow text-muted-foreground">Takeaway</figcaption>
                <p class="mt-2 font-heading text-[1.05rem] leading-relaxed">{s.arc.takeaway}</p>
              </figure>
            )}
          </section>
        </>
      )
    }
  </section>

  {
    tool && (
      <section id="tool" aria-labelledby="tool-title">
        <div class="eyebrow text-gold">Your numbers</div>
        <h2 class={h2} id="tool-title">
          Run the comparison with your prices
        </h2>
        <HeatingCost spec={tool} t={t} s={s} counts={labelCounts(claims)} />
      </section>
    )
  }

  <section aria-labelledby="claims">
    <div class="eyebrow text-gold">Section III</div>
    <h2 class={h2} id="claims">The claims examined</h2>
    <p class="mb-3 text-sm text-muted-foreground">
      Each claim as the sources make it, its verdict, and the quote or study lines it rests on.{' '}
      <a href={href('/about/#labels')}>How to read the finding labels.</a>
    </p>
    {
      groups.map((g) => (
        <>
          <h3 class="mt-5 mb-1 text-title font-semibold" id={`evidence-${g.label}`}>
            {FINDING_TEXT[g.label].name}
          </h3>
          {g.claims.map((c) => (
            <ClaimCard claim={c} group="story" />
          ))}
        </>
      ))
    }
  </section>

  <section aria-labelledby="exhibits">
    <div class="eyebrow text-gold">Exhibits</div>
    <h2 class={h2} id="exhibits">The sources this matter rests on</h2>
    <p class="mb-3 text-sm text-muted-foreground">
      Numbered as in the inquiry; <a href={href(`/${t.name}/#sources`)}>every exhibit is listed in the full report</a>.
    </p>
    <ul class="grid list-none gap-1.5 p-0">
      {
        exhibits.map((x) => (
          <li class:list={[!x.exhibit && 'dev-only']}>
            <span class="font-mono text-xs text-muted-foreground">
              {x.exhibit ? `Exhibit ${x.exhibit}` : 'Exhibit number assigned at release'}
            </span>{' '}
            · <SourceLink source={x} /> <span class="text-sm text-muted-foreground">· {x.channel}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    s.chain && s.chain.length > 0 && (
      <section aria-labelledby="chain">
        <div class="eyebrow text-gold">Section IV</div>
        <h2 class={h2} id="chain">
          Questions that follow
        </h2>
        <MatterList
          items={s.chain
            .filter((q) => graph.nodes.get(storyNode(t.name, q.id))?.public)
            .map((q) => matterItem(graph, storyNode(t.name, q.id)))}
        />
      </section>
    )
  }

  {
    relatedItems.length > 0 && (
      <section aria-labelledby="related">
        <div class="eyebrow text-gold">See also</div>
        <h2 class={h2} id="related">
          Related matters
        </h2>
        <MatterList items={relatedItems} />
      </section>
    )
  }

  <footer
    class="flex flex-wrap items-center justify-between gap-4 border-y-4 border-double py-5 text-sm text-muted-foreground"
  >
    <div class="grid gap-2">
      <div class="eyebrow text-gold">Entered into the Public Record</div>
      <p class="font-heading text-[1.05rem] text-foreground">The matter is before the {body}.</p>
      <p class="max-w-prose">
        Part of the inquiry into <a href={href(`/${t.name}/`)}>{t.label}</a>, where every source and claim is listed:{
          ' '
        }
        <a href={href(`/${t.name}/#matters`)}>all matters in this inquiry</a>. Corrections are welcome and recorded with
        their date: <a href={`${site.repo}/issues`}>raise one</a>.
      </p>
      {
        revisions.length > 0 && (
          <>
            <h2 class="eyebrow text-gold">Revisions</h2>
            <ul class="grid list-none gap-1 p-0">
              {revisions.map(({ r, text }) => (
                <li>
                  {revisionLine(r)} <span class="text-muted-foreground">({text})</span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
    <Stamp brand={commissionKey(commission)} slot="stamp-record" form="rect" class="w-44 shrink-0 sm:w-52" />
  </footer>
</Base>
