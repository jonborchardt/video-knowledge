---
// One institution of the Commonwealth: what it is for, where it publishes, the inquiries it owns and every story in
// them. Stories are candidates from stories.json, each linked to its own page ([topic]/[story].astro); one not ready
// is marked under examination. A chain's follow-ups ride with their first question.
import Base from '../../layouts/Base.astro';
import ReportHeader from '../../components/ReportHeader.astro';
import KindIcon from '../../components/KindIcon.astro';
import MatterList from '../../components/MatterList.astro';
import SourceIcons from '../../components/SourceIcons.astro';
import { inquiryMatters, breadcrumbJsonLd, collectionJsonLd } from '../../modules/website';
import { siteGraph, siteTopics } from '../../modules/website/site-graph';
import { type Commission, commissionBody, commissions, site } from '../../config/site';
import { loadTopic, type Topic } from '../../lib/topics';
import { href } from '../../lib/url';

export function getStaticPaths() {
  const names = new Set(siteTopics());
  return Object.entries(commissions).map(([id, c]) => ({
    params: { id },
    props: { c, topics: c.topics.filter((n) => names.has(n)).map(loadTopic) },
  }));
}
const { c, topics } = Astro.props as { c: Commission; topics: Topic[] };
const graph = siteGraph();
// Every matter of each inquiry in the one order (D9), a chain's follow-ups under their first question.
const docket = topics.map((t) => ({
  t,
  items: inquiryMatters(graph, t.name),
}));
const total = docket.reduce((n, d) => n + d.items.length, 0);
const body = commissionBody(c);
---

<Base
  title={`${c.name} · ${site.name}`}
  description={c.remit}
  image={`/og/${Astro.params.id}.jpg`}
  jsonLd={[
    collectionJsonLd(c.ceremonialName, c.remit, `/commissions/${Astro.params.id}/`),
    breadcrumbJsonLd([{ name: c.name, path: `/commissions/${Astro.params.id}/` }]),
  ]}
>
  <SourceIcons />
  <ReportHeader
    brand={Astro.params.id}
    kind="Institution"
    trail={[{ label: site.name, href: href('/') }]}
    title={c.ceremonialName}
    bigSeal
    facts={[
      c.youtube
        ? { term: 'Channel', value: c.fullName, href: c.youtube, rel: 'me', kind: 'external' as const }
        : { term: 'Channel', value: `${c.fullName} · coming soon` },
      {
        term: 'Record',
        value: topics.length
          ? `${topics.length} ${topics.length === 1 ? 'inquiry' : 'inquiries'} · ${total} stories`
          : 'no inquiry published yet',
      },
    ]}
  >
    {c.slogan && <p class="font-heading text-lg italic">{c.slogan}</p>}
    <p class="max-w-prose text-muted-foreground">{c.remit}</p>
    <!-- The channel's link points here, so this greets a viewer arriving from a video. -->
    <p class="max-w-prose">
      This is the {body}'s entry in {site.publicRecord}. Every video it publishes rests on an inquiry here: the videos
      and posts examined, each claim they make, and the verdict on it with the lines of evidence behind it.{' '}
      <a href={href('/about/')}>How to read the record.</a>
    </p>
  </ReportHeader>

  {topics.length === 0 && <p class="text-muted-foreground">No findings published yet.</p>}

  {
    topics.length > 0 && (
      <section aria-label="Inquiries">
        <div class="eyebrow text-gold">Section I</div>
        <h2 class="mb-3 text-featured font-bold">Public inquiries</h2>
        <ul class="grid list-none grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-3 p-0">
          {topics.map((t) => (
            <li>
              <a
                class="grid h-full grid-cols-[auto_1fr] content-start items-start gap-3 rounded-md border bg-card p-4 no-underline hover:border-primary"
                href={href(`/${t.name}/`)}
              >
                {/* eslint-disable-next-line astro/no-set-html-directive -- glyphs are committed topics/<topic>/glyph.svg files */}
                {t.glyph && <span class="size-10 text-primary [&>svg]:size-full" set:html={t.glyph} />}
                <span class="grid gap-1">
                  <span class="font-heading text-title font-bold text-primary">{t.label}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    total > 0 && (
      <section aria-label="Stories">
        <div class="eyebrow text-gold">Section II</div>
        <h2 class="mb-3 text-featured font-bold">Matters before the {body}</h2>
        <p class="mb-4 max-w-prose text-sm text-muted-foreground">
          Every question the {c.name} has taken up, by inquiry. A matter under examination has its evidence still being
          weighed; the rest answer to the findings in the record.
        </p>
        {docket
          .filter((d) => d.items.length)
          .map(({ t, items }) => (
            <>
              <h3 class="mt-5 mb-2 flex items-baseline gap-2 text-title font-bold">
                <KindIcon kind="inquiry" class="text-muted-foreground" />
                <a href={href(`/${t.name}/`)}>{t.label}</a>
              </h3>
              <MatterList items={items} />
            </>
          ))}
      </section>
    )
  }

  <footer class="grid gap-2 border-y-4 border-double py-5 text-sm text-muted-foreground">
    <div class="eyebrow text-gold">{site.publicRecord}</div>
    <p class="max-w-prose">
      {c.fullName}. <a href={href('/about/')}>How an inquiry is built</a> and how to read its verdicts.
    </p>
  </footer>
</Base>
