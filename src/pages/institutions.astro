---
// The institutional directory: one card per institution of the Commonwealth, with the inquiries it has published and
// a featured story. A topic no institution claims is not listed (publicTopicNames); an institution without a channel
// says so rather than inventing a handle.
import Base from '../layouts/Base.astro';
import InstitutionCard from '../components/InstitutionCard.astro';
import SourceIcons from '../components/SourceIcons.astro';
import { matterOrder } from '../lib/content-graph';
import { siteGraph, siteTopics } from '../lib/site-graph';
import { commissions, site } from '../config/site';
import { breadcrumbJsonLd, collectionJsonLd } from '../lib/seo';
import { loadTopic } from '../lib/topics';
import { href } from '../lib/url';

const graph = siteGraph();
const names = new Set(siteTopics(graph));
const institutions = Object.values(commissions).map((c) => {
  const published = c.topics.filter((n) => names.has(n)).map((n) => loadTopic(n));
  // Featured: the first ready matter across the institution's inquiries in the one order (a live video first); a
  // follow-up is never featured on its own.
  const first = [...graph.nodes.values()]
    .filter((n) => n.kind === 'story' && n.public && !graph.stories.get(n.id)!.partOf)
    .filter((n) => published.some((t) => t.name === n.topic))
    .sort((a, b) => matterOrder(graph, a, b))[0];
  const featured = first
    ? { s: graph.stories.get(first.id)!, t: published.find((t) => t.name === first.topic)! }
    : null;
  return { c, published, featured };
});
const description = `The institutions of ${site.name}: what each is for, where it publishes and the inquiries it has opened.`;
---

<Base
  title={`Institutions · ${site.name}`}
  description={description}
  jsonLd={[
    collectionJsonLd(`Institutions of ${site.name}`, description, '/institutions/', Astro.site!),
    breadcrumbJsonLd(
      [
        { name: site.name, path: '/' },
        { name: 'Institutions', path: '/institutions/' },
      ],
      Astro.site!,
    ),
  ]}
>
  <SourceIcons />
  <header class="grid gap-3 border-b pb-8">
    <div class="eyebrow text-muted-foreground"><a href={href('/')}>{site.publicRecord}</a></div>
    <h1 class="text-display font-bold">The institutions</h1>
    <p class="max-w-prose text-lg">
      Each institution of the Commonwealth publishes its inquiries here and on its own channel.
    </p>
  </header>

  <section class="grid gap-6" aria-label="Institutions">
    {institutions.map((x) => <InstitutionCard {...x} />)}
  </section>
</Base>
