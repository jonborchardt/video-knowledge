---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="Page not found" noindex>
  <header>
    <h1 class="text-display font-semibold">Page not found</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      That page is not in the record, or the inquiry it belonged to was withdrawn. <a href={href('/')}>
        Back to the Public Record</a
      >.
    </p>
  </header>
</Base>
