---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="Page not found">
  <header>
    <h1 class="text-display font-semibold">Page not found</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      That page does not exist, or the subject it belonged to was removed. <a href={href('/')}>See all subjects</a>.
    </p>
  </header>
</Base>
