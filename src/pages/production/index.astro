---
// The production board: every topic's research pipeline, its story candidates, and each script's artifacts, with the
// stage, health, blockers and next step derived from the committed files (src/lib/production.ts). Static, no client
// script: a working view for the people running the pipeline.
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
import { board, type Check, type Health, PRODUCTION_STAGES } from '../../lib/production';
import { href } from '../../lib/url';

const topics = board();
const productions = topics.flatMap((t) => t.stories.filter((s) => s.production));
const HEALTH: Record<Health, { label: string; colour: string }> = {
  done: { label: 'locked', colour: 'text-success' },
  current: { label: 'current', colour: 'text-success' },
  pending: { label: 'pending', colour: 'text-warning' },
  stale: { label: 'stale', colour: 'text-warning' },
  blocked: { label: 'blocked', colour: 'text-destructive' },
  missing: { label: 'missing', colour: 'text-muted-foreground' },
};
const READY: Record<string, string> = {
  ready: 'text-success',
  'needs-review': 'text-warning',
  'needs-research': 'text-primary',
  rejected: 'text-destructive',
};
const badge =
  'inline-block rounded-sm border border-current px-1.5 py-1 font-mono text-[11px] leading-none tracking-[.06em] whitespace-nowrap uppercase';
const small = 'text-sm text-muted-foreground';
const mono = 'font-mono text-xs [overflow-wrap:anywhere]';
const blob = (file: string) => `${site.repo}/blob/main/${file}`;
const day = (iso?: string) => (iso ? iso.slice(0, 10) : '');
const chip = (c: Check) => `${c.name}: ${c.health}`;
const counts = Object.fromEntries(
  (['done', 'current', 'pending', 'stale', 'blocked', 'missing'] as Health[]).map((h) => [
    h,
    productions.filter((s) => s.production!.health === h).length,
  ]),
);
---

<Base
  title="Production board"
  description="What stage every topic, story and script is in, derived from the committed artifacts."
>
  <header>
    <div class="eyebrow text-muted-foreground">Production</div>
    <h1 class="mt-1 text-display font-semibold">Topic → story → script</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      Everything on this page is read from the repository: the stores, reports, story candidates and script directories.
      A stage is <em>current</em> when re-running its library on today's inputs reproduces the committed file (the same test
      <code>lock</code> applies), <em>stale</em> when it would not, <em>pending</em> when an agent step is owed, <em
        >blocked</em
      > when the gate says so. The next step is the command or brief that moves the item on. The only hand-written input is
      <code>production.json</code> (queued, parked, published), because no artifact records those decisions.
    </p>
    <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
      <div>
        <dt class="inline text-muted-foreground">Topics</dt>
        <dd class="inline font-medium">{topics.length}</dd>
      </div>
      <div>
        <dt class="inline text-muted-foreground">Stories</dt>
        <dd class="inline font-medium">{topics.reduce((n, t) => n + t.stories.length, 0)}</dd>
      </div>
      <div>
        <dt class="inline text-muted-foreground">Ready, unscripted</dt>
        <dd class="inline font-medium">
          {
            topics.reduce(
              (n, t) => n + t.stories.filter((s) => s.story.readiness === 'ready' && !s.production).length,
              0,
            )
          }
        </dd>
      </div>
      <div>
        <dt class="inline text-muted-foreground">Scripts</dt>
        <dd class="inline font-medium">{productions.length}</dd>
      </div>
      {
        Object.entries(counts)
          .filter(([, n]) => n)
          .map(([h, n]) => (
            <div>
              <dt class:list={['inline', HEALTH[h as Health].colour]}>{HEALTH[h as Health].label}</dt>{' '}
              <dd class="inline font-medium">{n}</dd>
            </div>
          ))
      }
    </dl>
  </header>

  {
    topics.map(({ topic: t, checks, stories, rejected, next }) => (
      <section class="grid gap-4 rounded-lg border bg-card p-4 text-card-foreground">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <h2 class="text-featured font-semibold">
              <a class="text-primary" href={href(`/${t.name}/`)}>
                {t.label}
              </a>
            </h2>
            <p class={small}>
              {t.counted} sources · {t.claims.length} claims · {t.studies} studies · {stories.length} stories ·{' '}
              {rejected} rejected
            </p>
          </div>
          <p class="max-w-prose text-sm">
            <span class="eyebrow text-muted-foreground">Next</span> <code class={mono}>{next}</code>
          </p>
        </div>

        <ul class="flex flex-wrap gap-2" aria-label="Research pipeline">
          {checks.map((c) => (
            <li>
              <details class="group">
                <summary
                  class:list={[
                    badge,
                    HEALTH[c.health].colour,
                    'cursor-pointer list-none [&::-webkit-details-marker]:hidden',
                  ]}
                  title={c.detail}
                >
                  {chip(c)}
                </summary>
                <p class="mt-1 max-w-prose text-sm">
                  {c.detail}
                  {c.file && (
                    <>
                      {' '}
                      <a class={mono} href={blob(c.file)}>
                        {c.file}
                      </a>
                    </>
                  )}
                </p>
              </details>
            </li>
          ))}
        </ul>

        {stories.length > 0 && (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="text-left text-xs text-muted-foreground uppercase">
                <tr>
                  <th class="py-1 pr-3 font-medium">Story</th>
                  <th class="py-1 pr-3 font-medium">Readiness</th>
                  <th class="py-1 pr-3 font-medium">Production</th>
                  <th class="py-1 pr-3 font-medium">Next</th>
                </tr>
              </thead>
              <tbody class="align-top">
                {stories.map(({ story: s, decision, production: p, next: n }) => (
                  <tr class="border-t">
                    <td class="py-2 pr-3">
                      <div class="font-medium">{s.title}</div>
                      <div class={[mono, 'text-muted-foreground'].join(' ')}>
                        {s.id} · {s.format} · {s.scores.overall.toFixed(2)}
                      </div>
                      {decision && (
                        <div class="mt-1 text-xs">
                          <span class={badge}>{decision.decision}</span> {decision.note}
                          {decision.url && (
                            <>
                              {' '}
                              <a href={decision.url}>{decision.url}</a>
                            </>
                          )}
                        </div>
                      )}
                    </td>
                    <td class="py-2 pr-3">
                      <span class:list={[badge, READY[s.readiness]]}>{s.readiness}</span>
                      {s.blocking.length > 0 && (
                        <ul class="mt-1 max-w-xs list-disc pl-4 text-xs text-muted-foreground">
                          {s.blocking.slice(0, 2).map((b) => (
                            <li>{b.length > 140 ? b.slice(0, 140) + '…' : b}</li>
                          ))}
                        </ul>
                      )}
                    </td>
                    <td class="py-2 pr-3 whitespace-nowrap">
                      {p ? (
                        <a href={`#${t.name}-${p.slug}`} class:list={[badge, HEALTH[p.health].colour]}>
                          {p.stage} · {HEALTH[p.health].label}
                        </a>
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )}
                      {p && p.versions.length > 0 && (
                        <div class={[mono, 'mt-1 text-muted-foreground'].join(' ')}>
                          {p.versions.length} revision{p.versions.length === 1 ? '' : 's'}
                        </div>
                      )}
                    </td>
                    <td class="py-2">
                      <code class={mono}>{n}</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    ))
  }

  {
    productions.length > 0 && (
      <section class="grid gap-6">
        <h2 class="text-featured font-semibold">Scripts: artifact inspection</h2>
        {productions.map(({ production: p }) => (
          <article id={`${p!.topic}-${p!.slug}`} class="grid gap-3 rounded-lg border bg-card p-4 text-card-foreground">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <div class="eyebrow text-muted-foreground">
                  {p!.topic} / {p!.story}
                </div>
                <h3 class="text-title font-semibold">
                  <a class="text-primary" href={href(`/${p!.topic}/scripts/${p!.slug}/`)}>
                    {p!.dir}
                  </a>
                </h3>
                <p class={small}>
                  {p!.model ?? 'no model recorded'} · script {p!.fingerprints.script ?? '—'} · package{' '}
                  {p!.fingerprints.package ?? '—'}
                </p>
              </div>
              <span class:list={[badge, HEALTH[p!.health].colour]}>
                {p!.stage} · {HEALTH[p!.health].label}
              </span>
            </div>

            <ol class="flex flex-wrap gap-1 text-xs" aria-label="Stages">
              {PRODUCTION_STAGES.map((s, i) => {
                const at = PRODUCTION_STAGES.indexOf(p!.stage);
                return (
                  <li
                    class:list={[
                      'rounded-sm border px-1.5 py-0.5 font-mono',
                      i < at
                        ? 'border-success text-success'
                        : i === at
                          ? 'border-current font-semibold'
                          : 'text-muted-foreground',
                    ]}
                  >
                    {s}
                  </li>
                );
              })}
            </ol>

            <p class="text-sm">
              <span class="eyebrow text-muted-foreground">Next</span> <code class={mono}>{p!.next}</code>
            </p>
            {p!.blockers.length > 0 && (
              <ul class="list-disc pl-5 text-sm text-warning">
                {p!.blockers.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}

            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="text-left text-xs text-muted-foreground uppercase">
                  <tr>
                    <th class="py-1 pr-3 font-medium">Artifact</th>
                    <th class="py-1 pr-3 font-medium">Health</th>
                    <th class="py-1 pr-3 font-medium">Detail</th>
                    <th class="py-1 font-medium">Date</th>
                  </tr>
                </thead>
                <tbody class="align-top">
                  {p!.checks.map((c) => (
                    <tr class="border-t">
                      <td class="py-1.5 pr-3 whitespace-nowrap">
                        {c.file ? (
                          <a class={mono} href={blob(c.file)}>
                            {c.name}
                          </a>
                        ) : (
                          <span class={mono}>{c.name}</span>
                        )}
                      </td>
                      <td class="py-1.5 pr-3">
                        <span class:list={[badge, HEALTH[c.health].colour]}>{HEALTH[c.health].label}</span>
                      </td>
                      <td class="py-1.5 pr-3">{c.detail}</td>
                      <td class:list={['py-1.5 whitespace-nowrap', mono, 'text-muted-foreground']}>{day(c.date)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {p!.versions.length > 0 && (
              <div>
                <h4 class="mb-1 text-sm font-semibold">Revisions</h4>
                <ol class="grid gap-1 text-sm">
                  {p!.versions.map((v) => (
                    <li class="flex flex-wrap items-center gap-2">
                      <span class={mono}>r{v.revision}</span>
                      <span class={[mono, 'text-muted-foreground'].join(' ')}>{day(v.date)}</span>
                      <span
                        class:list={[
                          badge,
                          v.status === 'passed'
                            ? 'text-success'
                            : v.status === 'blocked'
                              ? 'text-destructive'
                              : 'text-warning',
                        ]}
                      >
                        {v.status}
                      </span>
                      <span class="text-muted-foreground">
                        {v.blocking} blocking, {v.warnings} warnings
                      </span>
                      {v.reviewed && <span class={badge}>reviewed</span>}
                      {v.locked && <span class:list={[badge, 'text-success']}>locked</span>}
                    </li>
                  ))}
                </ol>
              </div>
            )}

            <dl class="grid gap-x-4 gap-y-1 text-xs sm:grid-cols-[auto_1fr]">
              {Object.entries(p!.fingerprints).map(([k, v]) => (
                <>
                  <dt class="font-mono text-muted-foreground uppercase">{k}</dt>
                  <dd class="font-mono">{v ?? '—'}</dd>
                </>
              ))}
            </dl>
          </article>
        ))}
      </section>
    )
  }
</Base>
