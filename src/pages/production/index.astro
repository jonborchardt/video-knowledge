---
// The production board: one row per video across topics (a chain is one row; its follow-up questions get none),
// in the state of who acts next (src/lib/production.ts columnOf), sortable and filterable. The strip in a row is the
// production stages.
// Above it, each topic's research pipeline; below, artifact-by-artifact inspection of every script directory.
import Base from '../../layouts/Base.astro';
import NextStep from '../../components/NextStep.astro';
import { site } from '../../config/site';
import {
  board,
  type Check,
  type Column,
  COLUMNS,
  columnOf,
  type Health,
  PRODUCTION_STAGES,
  type StoryRow,
} from '../../lib/production';
import { href } from '../../lib/url';

const topics = board();
const rows = topics.flatMap((t) => t.stories.map((s) => ({ ...s, topic: t.topic })));
const productions = rows.filter((s) => s.production);
// One row per video, in board order (who acts next), best first within a state; follow-ups ride on their chain.
const videos = rows
  .filter((r) => columnOf(r))
  .sort(
    (a, b) =>
      COLUMNS.indexOf(columnOf(a)!) - COLUMNS.indexOf(columnOf(b)!) || b.story.scores.overall - a.story.scores.overall,
  );
// Table headers; a type makes the column sortable (the script below reads a cell's data-sort, else its text).
const SORTABLE = [
  ['Topic', 'text'],
  ['Title', 'text'],
  ['Question', 'text'],
  ['Overall', 'num'],
  ['Editorial', 'num'],
  ['Evidence', 'num'],
  ['Claims', 'num'],
  ['State', 'num'],
  ['Next', ''],
  ['Notes', ''],
] as const;
type Row = (typeof rows)[number];
// A chain's row carries every question it answers and the claims of all of them.
const followUps = (r: Row) =>
  (r.story.chain ?? [])
    .map((c) => rows.find((x) => x.topic.name === r.topic.name && x.story.id === c.id)?.story)
    .filter((s) => s?.partOf === r.story.id);
// Halts /produce stops on (.claude/skills/produce/SKILL.md): a person must act; every other halt is its next step.
const stopped = (r: StoryRow) =>
  !!r.production &&
  (['revision-limit', 'story-left'].includes(r.production.halt?.kind ?? '') || r.next.startsWith('stop:'));
const claimsOf = (r: Row) => new Set([r.story, ...followUps(r)].flatMap((s) => s?.claims ?? [])).size;
const HEALTH: Record<Health, { label: string; colour: string }> = {
  done: { label: 'done', colour: 'text-success' },
  current: { label: 'current', colour: 'text-success' },
  pending: { label: 'pending', colour: 'text-warning' },
  stale: { label: 'stale', colour: 'text-warning' },
  blocked: { label: 'blocked', colour: 'text-destructive' },
  missing: { label: 'missing', colour: 'text-muted-foreground' },
};
const COLUMN: Record<Column, { label: string; help: string; colour: string }> = {
  'needs-research': {
    label: 'Needs research',
    help: 'essential evidence missing (scripts/briefs/sources.md)',
    colour: 'text-primary',
  },
  'needs-review': { label: 'Needs review', help: 'a person settles the listed points', colour: 'text-warning' },
  ready: { label: 'Ready to produce', help: 'start it with /produce', colour: 'text-success' },
  producing: {
    label: 'In production',
    help: '/produce is on it; the strip shows the stage, red means it stopped and needs you',
    colour: '',
  },
  'your-review': {
    label: 'Your review',
    help: 'private package made; upload it and watch',
    colour: 'text-success',
  },
  reviewing: {
    label: 'In review',
    help: 'uploaded privately; a person is reviewing (production.json)',
    colour: 'text-warning',
  },
  published: { label: 'Published', help: 'production.json', colour: 'text-success' },
  parked: { label: 'Parked', help: 'production.json', colour: 'text-muted-foreground' },
};
const badge =
  'inline-block rounded-sm border border-current px-1.5 py-1 font-mono text-[11px] leading-none tracking-[.06em] whitespace-nowrap uppercase';
const small = 'text-sm text-muted-foreground';
// A filter tag: a hidden checkbox in a chip that fills when checked; the focus ring follows the keyboard.
const tag =
  'cursor-pointer rounded-full border px-2 py-0.5 text-xs select-none hover:bg-muted has-checked:border-primary has-checked:bg-primary has-checked:text-primary-foreground has-focus-visible:ring-2 has-focus-visible:ring-ring';
const mono = 'font-mono text-xs [overflow-wrap:anywhere]';
const blob = (file: string) => `${site.repo}/blob/main/${file}`;
const day = (iso?: string) => (iso ? iso.slice(0, 10) : '');
const chip = (c: Check) => `${c.name}: ${c.health}`;
const rowHealth = (r: StoryRow): Health =>
  r.production ? r.production.health : r.story.readiness === 'ready' ? 'current' : 'pending';
// The production stages in a row: what has run, the stage it is at, and what is still to come.
const stripOf = (r: StoryRow) => {
  const col = columnOf(r);
  const at =
    col === 'reviewing' || col === 'published'
      ? PRODUCTION_STAGES.length
      : r.production
        ? PRODUCTION_STAGES.indexOf(r.production.stage)
        : -1;
  return PRODUCTION_STAGES.map((s, i) => ({ s, state: i < at ? 'done' : i === at ? 'current' : 'todo' }));
};
---

<Base
  title="Production board"
  description="What stage every topic, story and script is in, derived from the committed artifacts."
>
  <header>
    <div class="eyebrow text-muted-foreground">Production</div>
    <h1 class="mt-1 text-display font-semibold">Topic → story → script</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      One row per video; its state is whoever acts next. A chain of questions is one row; its follow-up questions have
      none. Click a header to sort; filter by text, topic or state. The state comes from the committed artifacts:
      readiness from <code>stories.json</code>, then the first production stage whose file is missing or not current
      (re-running the library on today's inputs must reproduce the file, the test <code>lock</code> applies). The strip in
      each row is the production stages: what has run (filled), the stage it is at, and what is still to come; red means <code
        >/produce</code
      > stopped and a person must act. Only <code>production.json</code> is hand-written (queued, reviewing, parked, published),
      because no artifact records those.
    </p>
  </header>

  <section class="grid gap-3">
    <h2 class="text-featured font-semibold">Research pipeline</h2>
    {
      topics.map(({ topic: t, checks, stories, rejected, next }) => (
        <div class="grid gap-2 rounded-lg border bg-card p-3 text-card-foreground sm:grid-cols-[14rem_1fr]">
          <div>
            <a class="font-semibold text-primary" href={href(`/${t.name}/`)}>
              {t.label}
            </a>
            <p class={small}>
              {t.counted} sources · {t.claims.length} claims · {t.studies} studies · {stories.length} stories ·{' '}
              {rejected} rejected
            </p>
          </div>
          <div class="grid gap-2">
            <ul class="flex flex-wrap gap-2" aria-label="Research pipeline">
              {checks.map((c) => (
                <li>
                  <details>
                    <summary
                      class:list={[
                        badge,
                        HEALTH[c.health].colour,
                        'cursor-pointer list-none [&::-webkit-details-marker]:hidden',
                      ]}
                      title={c.detail}
                    >
                      {chip(c)}
                    </summary>
                    <p class="mt-1 max-w-prose text-sm">
                      {c.detail}
                      {c.file && (
                        <>
                          {' '}
                          <a class={mono} href={blob(c.file)}>
                            {c.file}
                          </a>
                        </>
                      )}
                    </p>
                  </details>
                </li>
              ))}
            </ul>
            <p class="text-sm">
              <span class="eyebrow text-muted-foreground">Next</span> <code class={mono}>{next}</code>
            </p>
            <NextStep id={`next-${t.name}`} next={next} topic={t.name} />
          </div>
        </div>
      ))
    }
  </section>

  <section class="grid gap-3">
    <h2 class="text-featured font-semibold">Stories</h2>
    <form id="story-filter" class="grid gap-2 text-sm">
      <div class="flex flex-wrap items-center gap-2">
        <input
          type="search"
          name="q"
          placeholder="Filter by text"
          aria-label="Filter stories by text"
          class="min-w-48 flex-1 rounded-sm border bg-card px-2 py-1"
        />
        <label class={tag}>
          <input type="checkbox" name="stopped" aria-label="Stopped only" class="sr-only" /> stopped
        </label>
        <output name="count" class="ml-auto font-mono text-xs text-muted-foreground">{videos.length} videos</output>
      </div>
      {
        (
          [
            [
              'topic',
              'Topic',
              topics.map(({ topic: t }) => [t.name, t.label, videos.filter((r) => r.topic.name === t.name).length]),
            ],
            [
              'state',
              'State',
              COLUMNS.map((c) => [c, COLUMN[c].label, videos.filter((r) => columnOf(r) === c).length]),
            ],
          ] as const
        ).map(([name, legend, options]) => (
          <fieldset class="flex flex-wrap items-center gap-1.5">
            <legend class="float-left mr-1 eyebrow text-muted-foreground">{legend}</legend>
            {options.map(([value, label, n]) => (
              <label class:list={[tag, !n && 'opacity-50']}>
                <input type="checkbox" name={name} value={value} aria-label={`${legend}: ${label}`} class="sr-only" />{' '}
                {label} <span class="font-mono text-xs opacity-70">{n}</span>
              </label>
            ))}
          </fieldset>
        ))
      }
    </form>
    <div class="mx-[calc(50%-50vw+1rem)] overflow-x-auto pb-3">
      <table id="story-table" class="w-full min-w-[64rem] text-sm">
        <thead class="text-left text-xs text-muted-foreground uppercase">
          <tr>
            {
              SORTABLE.map(([label, type]) => (
                <th class="py-1 pr-3 align-bottom font-medium" data-type={type || undefined}>
                  {type ? (
                    <button type="button" class="uppercase hover:text-foreground">
                      {label}
                    </button>
                  ) : (
                    label
                  )}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="align-top">
          {
            videos.map((r) => {
              const c = columnOf(r)!;
              const h = rowHealth(r);
              const target = r.production ? `#${r.topic.name}-${r.production.slug}` : href(`/${r.topic.name}/stories/`);
              const notes = [
                ...(r.decision ? [`${r.decision.decision} ${day(r.decision.date)}: ${r.decision.note}`] : []),
                ...(r.production?.blockers ?? []),
                ...(r.production ? [] : r.story.blocking),
              ];
              return (
                <tr
                  class="border-t"
                  data-topic={r.topic.name}
                  data-state={c}
                  data-stopped={stopped(r) ? '' : undefined}
                  data-search={[
                    r.topic.label,
                    r.story.title,
                    r.story.question,
                    ...followUps(r).map((s) => s?.question),
                    COLUMN[c].label,
                    r.production?.stage,
                    r.next,
                    ...notes,
                  ]
                    .join(' ')
                    .toLowerCase()}
                >
                  <td class="py-2 pr-3 whitespace-nowrap">{r.topic.label}</td>
                  <td class="max-w-64 py-2 pr-3">
                    <a class="leading-snug font-medium text-primary" href={target}>
                      {r.story.title}
                    </a>
                    {followUps(r).length > 0 && (
                      <ul class="mt-1 grid gap-0.5 text-xs text-muted-foreground">
                        {followUps(r).map((s) => (
                          <li>then: {s?.question ?? '(follow-up not listed)'}</li>
                        ))}
                      </ul>
                    )}
                  </td>
                  <td class="max-w-80 py-2 pr-3 text-muted-foreground" title={r.story.whyWatch}>
                    {r.story.question}
                  </td>
                  {(['overall', 'editorial', 'evidence'] as const).map((k) => (
                    <td
                      class="py-2 pr-3 font-mono tabular-nums"
                      data-sort={r.story.scores[k]}
                      title={r.story.scores.explanation}
                    >
                      {r.story.scores[k].toFixed(2)}
                    </td>
                  ))}
                  <td
                    class="py-2 pr-3 font-mono tabular-nums"
                    data-sort={claimsOf(r)}
                    title="claims across every question in the video"
                  >
                    {claimsOf(r)}
                  </td>
                  <td class="py-2 pr-3" data-sort={COLUMNS.indexOf(c)}>
                    <div class="grid w-40 gap-1">
                      <span class:list={['font-medium', COLUMN[c].colour]} title={COLUMN[c].help}>
                        {COLUMN[c].label}
                      </span>
                      {r.production && (
                        <span class:list={[badge, 'justify-self-start', HEALTH[h].colour]}>
                          {r.production.stage} · {HEALTH[h].label} · r{r.production.versions.length || '0'}
                        </span>
                      )}
                      <ol class="flex gap-px" aria-label="Production stages">
                        {stripOf(r).map(({ s, state }) => (
                          <li
                            class:list={[
                              'h-1.5 flex-1 rounded-xs',
                              state === 'done'
                                ? 'bg-success'
                                : state === 'current'
                                  ? stopped(r)
                                    ? 'bg-destructive'
                                    : 'bg-warning'
                                  : 'bg-border',
                            ]}
                            title={`${s}: ${state}`}
                          />
                        ))}
                      </ol>
                    </div>
                  </td>
                  <td class="py-2 pr-3" title={r.next}>
                    <NextStep
                      id={`next-${r.topic.name}-${r.story.id.replace(/\W+/g, '-')}`}
                      next={r.next}
                      topic={r.topic.name}
                      story={r.story.id}
                      upload={r.production?.upload}
                      stage={
                        r.decision
                          ? undefined
                          : (r.production?.stage ?? (r.story.readiness === 'ready' ? 'ready' : undefined))
                      }
                    />
                  </td>
                  <td class="max-w-80 py-2 text-xs">
                    {stopped(r) && (
                      <p class="text-destructive">
                        stopped ({r.production!.halt?.kind ?? 'stop'}): {r.production!.halt?.why ?? r.next}
                      </p>
                    )}
                    {notes.length > 0 && (
                      <ul class="grid gap-0.5 text-muted-foreground">
                        {notes.map((n) => (
                          <li>{n}</li>
                        ))}
                      </ul>
                    )}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>

  {
    productions.length > 0 && (
      <section class="grid gap-6">
        <h2 class="text-featured font-semibold">Scripts: artifact inspection</h2>
        {productions.map(({ production: p }) => (
          <article id={`${p!.topic}-${p!.slug}`} class="grid gap-3 rounded-lg border bg-card p-4 text-card-foreground">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <div class="eyebrow text-muted-foreground">
                  {p!.topic} / {p!.story}
                </div>
                <h3 class="text-title font-semibold">
                  <a class="text-primary" href={href(`/${p!.topic}/scripts/${p!.slug}/`)}>
                    {p!.dir}
                  </a>
                </h3>
                <p class={small}>
                  {p!.model ?? 'no model recorded'} · script {p!.fingerprints.script ?? '—'} · package{' '}
                  {p!.fingerprints.package ?? '—'}
                </p>
              </div>
              <span class:list={[badge, HEALTH[p!.health].colour]}>
                {p!.stage} · {HEALTH[p!.health].label}
              </span>
            </div>

            <ol class="flex flex-wrap gap-1 text-xs" aria-label="Stages">
              {PRODUCTION_STAGES.map((s, i) => {
                const at = PRODUCTION_STAGES.indexOf(p!.stage);
                return (
                  <li
                    class:list={[
                      'rounded-sm border px-1.5 py-0.5 font-mono',
                      i < at
                        ? 'border-success text-success'
                        : i === at
                          ? 'border-current font-semibold'
                          : 'text-muted-foreground',
                    ]}
                  >
                    {s}
                  </li>
                );
              })}
            </ol>

            <p class="text-sm">
              <span class="eyebrow text-muted-foreground">Next</span> <code class={mono}>{p!.next}</code>
            </p>
            <NextStep
              id={`next-script-${p!.topic}-${p!.slug}`}
              next={p!.next}
              topic={p!.topic}
              story={p!.story}
              upload={p!.upload}
              stage={p!.stage}
            />
            {p!.blockers.length > 0 && (
              <ul class="list-disc pl-5 text-sm text-warning">
                {p!.blockers.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}

            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="text-left text-xs text-muted-foreground uppercase">
                  <tr>
                    <th class="py-1 pr-3 font-medium">Artifact</th>
                    <th class="py-1 pr-3 font-medium">Health</th>
                    <th class="py-1 pr-3 font-medium">Detail</th>
                    <th class="py-1 font-medium">Date</th>
                  </tr>
                </thead>
                <tbody class="align-top">
                  {p!.checks.map((c) => (
                    <tr class="border-t">
                      <td class="py-1.5 pr-3 whitespace-nowrap">
                        {c.file ? (
                          <a class={mono} href={blob(c.file)}>
                            {c.name}
                          </a>
                        ) : (
                          <span class={mono}>{c.name}</span>
                        )}
                      </td>
                      <td class="py-1.5 pr-3">
                        <span class:list={[badge, HEALTH[c.health].colour]}>{HEALTH[c.health].label}</span>
                      </td>
                      <td class="py-1.5 pr-3">{c.detail}</td>
                      <td class:list={['py-1.5 whitespace-nowrap', mono, 'text-muted-foreground']}>{day(c.date)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {p!.versions.length > 0 && (
              <div>
                <h4 class="mb-1 text-sm font-semibold">Revisions</h4>
                <ol class="grid gap-1 text-sm">
                  {p!.versions.map((v) => (
                    <li class="flex flex-wrap items-center gap-2">
                      <span class={mono}>r{v.revision}</span>
                      <span class={[mono, 'text-muted-foreground'].join(' ')}>{day(v.date)}</span>
                      <span
                        class:list={[
                          badge,
                          v.status === 'passed'
                            ? 'text-success'
                            : v.status === 'blocked'
                              ? 'text-destructive'
                              : 'text-warning',
                        ]}
                      >
                        {v.status}
                      </span>
                      <span class="text-muted-foreground">
                        {v.blocking} blocking, {v.warnings} warnings
                      </span>
                      {v.reviewed && <span class={badge}>reviewed</span>}
                      {v.locked && <span class:list={[badge, 'text-success']}>locked</span>}
                    </li>
                  ))}
                </ol>
              </div>
            )}

            <dl class="grid gap-x-4 gap-y-1 text-xs sm:grid-cols-[auto_1fr]">
              {Object.entries(p!.fingerprints).map(([k, v]) => (
                <>
                  <dt class="font-mono text-muted-foreground uppercase">{k}</dt>
                  <dd class="font-mono">{v ?? '—'}</dd>
                </>
              ))}
            </dl>
          </article>
        ))}
      </section>
    )
  }
</Base>

<script>
  // The stories table: click a header to sort (numbers high first, text A-Z first; again to reverse), and the form
  // above it filters rows by text, topic tags, state tags and whether /produce stopped.
  const table = document.getElementById('story-table') as HTMLTableElement;
  const body = table.tBodies[0];
  const heads = [...table.tHead!.rows[0].cells];
  const form = document.getElementById('story-filter') as HTMLFormElement;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  // A tag group with nothing checked filters nothing.
  const checked = (n: string) =>
    [...form.querySelectorAll<HTMLInputElement>(`input[name=${n}]:checked`)].map((i) => i.value);

  table.tHead!.addEventListener('click', (e) => {
    const th = (e.target as Element).closest('th');
    if (!th?.dataset.type || !(e.target as Element).closest('button')) return;
    const i = heads.indexOf(th);
    const num = th.dataset.type === 'num';
    const down = th.getAttribute('aria-sort') ? th.getAttribute('aria-sort') === 'ascending' : num;
    heads.forEach((h) => h.removeAttribute('aria-sort'));
    th.setAttribute('aria-sort', down ? 'descending' : 'ascending');
    const key = (r: HTMLTableRowElement) => r.cells[i].dataset.sort ?? r.cells[i].textContent!.trim();
    const rows = [...body.rows].sort((a, b) => {
      const d = num ? Number(key(a)) - Number(key(b)) : key(a).localeCompare(key(b));
      return down ? -d : d;
    });
    body.append(...rows);
  });

  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('input', () => {
    const q = field('q').value.trim().toLowerCase();
    const topic = checked('topic');
    const state = checked('state');
    const stopped = field('stopped').checked;
    let shown = 0;
    for (const r of body.rows) {
      r.hidden = !(
        (!topic.length || topic.includes(r.dataset.topic!)) &&
        (!state.length || state.includes(r.dataset.state!)) &&
        (!stopped || r.dataset.stopped !== undefined) &&
        (!q || r.dataset.search!.includes(q))
      );
      if (!r.hidden) shown++;
    }
    (form.elements.namedItem('count') as HTMLOutputElement).value =
      shown === body.rows.length ? `${shown} videos` : `${shown} of ${body.rows.length} videos`;
  });
</script>
