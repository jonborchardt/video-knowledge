---
// The admin page, dev-only (astro.config.mjs): the production board (Board.astro: the board, stages, pipeline and
// artifacts tabs), the external services, and the maps of the workflow and the site.
import TabBar from '../components/TabBar.astro';
import Board from './Board.astro';
import Base from '../layouts/Base.astro';
import ObjectsDiagram from './ObjectsDiagram.astro';
import PathDiagram from './PathDiagram.astro';
import PlansDiagram from './PlansDiagram.astro';
import { serviceGroups } from './services';
import SiteMapDiagram from './SiteMapDiagram.astro';

const small = 'text-sm text-muted-foreground';
// One icon per kind of page, from the sprite in the template (the SourceIcons style: 16px, currentColor).
const ico = 'size-4 shrink-0';
const row = 'flex items-center gap-2';

// The whole workflow, top to bottom: `you` steps are a person's, the rest an agent's or a CLI's; `planned` is not built
// yet. Keep it current: a change to a stage, a halt a person resolves or a human step changes this list (CLAUDE.md).
type Step = { you?: boolean; planned?: boolean; t: string; d: string[] };
const flow: Step[] = [
  {
    you: true,
    t: 'Pick a topic, queue its sources',
    d: [
      'YouTube URLs or a queue file for the watcher;',
      'a commission in site.ts claims the topic',
      'so the site publishes it',
    ],
  },
  {
    t: 'Extract the claims (watcher)',
    d: [
      'transcripts and posts to canonical claims,',
      'one line, mechanism-level; an AI guess',
      'counts for at most 0.5 confidence',
    ],
  },
  {
    t: 'Judge them against studies',
    d: [
      'record-sources: a verdict per claim with',
      'its cited passage; npm run report writes',
      'report.json (needs the watcher checkout)',
    ],
  },
  {
    you: true,
    t: 'Explain each revised finding',
    d: [
      'npm run report lists claims whose label',
      'or verdict changed; report -- note <topic>',
      '<claim> "<note>"; no note fails the build',
    ],
  },
  {
    you: true,
    t: 'Claim the topic for an institution',
    d: [
      'add it to commissions in site.ts (a channel',
      'a person created, never an invented handle);',
      'npm run brand; unclaimed topics never produce',
    ],
  },
  {
    t: 'Find the stories',
    d: [
      'stories discover: candidates + evidence audit;',
      'stories.md agent: applicability, pruning,',
      'chains; board: needs-research/-review/ready',
    ],
  },
  {
    you: true,
    t: 'Start a ready story',
    d: [
      "copy /produce from the board's What next?,",
      'add Approver: your name (the lock sign-off);',
      'a red row later: fix it, paste it again',
    ],
  },
  {
    t: 'Script',
    d: [
      'evidence package; a writer (script.md),',
      'a different reviewer (script-review.md),',
      'validate; 3 revisions; evidence.md if needed',
    ],
  },
  {
    t: 'Storyboard, graphics, lock',
    d: ['storyboard.md; graphics.md per bespoke', 'scene, visual-review.md, render check;', 'lock writes release.json'],
  },
  {
    t: 'Draft video',
    d: ['video init, music cues; spike: edge voice,', 'Remotion render, mix, QA (fit guard)'],
  },
  {
    t: 'Article',
    d: [
      'a writer (article.md), a different reviewer',
      '(article-review.md), validate, lock; then',
      'the private package; board: your-review',
    ],
  },
  {
    you: true,
    t: 'Watch it on the review page',
    d: ['QA and script findings at their moment;', 'send back with timestamped notes, or', 'accept the draft'],
  },
  {
    t: 'Voice redo (video final)',
    d: [
      'the same words in the Azure neural voice,',
      'timeline, render, QA again; the release',
      'package: real title, no private banner',
    ],
  },
  {
    t: 'Choose the calls to action',
    d: [
      'cta.md agent: one primary, at most two',
      'secondaries, checked by cta.ts; package',
      'writes them into the description',
    ],
  },
  {
    you: true,
    planned: true,
    t: 'Approve any paid link',
    d: ['a commercial entry in cta.json needs', 'its disclosure and your approvedBy;', 'never the primary over a tool'],
  },
  {
    you: true,
    t: 'Approve the release build',
    d: [
      'tick every checklist item; binds the mp4',
      'and its title (a new title asks again);',
      'a title or thumbnail edit: updated event',
    ],
  },
  {
    t: 'Find the Shorts',
    d: [
      'shorts discover on the locked video;',
      'shorts.md agent: keep, hook, how each',
      'qualification is carried; at most 3',
    ],
  },
  {
    you: true,
    t: 'Start each Short',
    d: [
      '/produce <story>/shorts/<slug> with',
      'your name, as for the video; Shorts are',
      'made before the video launches',
    ],
  },
  {
    t: 'Produce the Short',
    d: [
      'the same loop in portrait (1080x1920),',
      'hook, finding, close, at most 170 s;',
      'draft, voice redo, release package',
    ],
  },
  {
    you: true,
    t: 'Review and approve each Short',
    d: ['the same review page, send-back and', 'checklist as the video; its approval', 'binds its own build and title'],
  },
  {
    you: true,
    t: 'Launch them together',
    d: [
      'upload the video and its Shorts (private);',
      'go live (or schedule): the video, then its',
      'Shorts; push / sync; board: published',
    ],
  },
  {
    you: true,
    t: 'Refresh the site',
    d: [
      'after go-live, the story joins the site:',
      'npm run report -- seed <topic>, npm run',
      'brand (cards, seals), commit; links freeze',
    ],
  },
  {
    you: true,
    t: 'Link the Shorts',
    d: [
      'set each related video in YouTube Studio',
      '(no API): updated --fields relatedVideo;',
      "a Short's description links the live video",
    ],
  },
  {
    you: true,
    t: 'Correct a released article',
    d: [
      'board: changed or stale (a cited finding was',
      'revised); article -- correct with --note',
      'records it in public-record.json; a stale',
      'text that stands: article -- reaffirm --note',
    ],
  },
  {
    planned: true,
    t: 'Tweets (planned)',
    d: ['posts for the X accounts in the brand', "kit's accounts.json; not built yet"],
  },
];
const W = 330,
  H = 80,
  ROW = 104,
  TOP = 40,
  LOOP = 14;
const xOf = (you?: boolean) => (you ? 40 : 430);
const yOf = (i: number) => TOP + i * ROW;
const mid = (you?: boolean) => xOf(you) + W / 2;
const back = flow.findIndex((s) => s.t.startsWith('Watch'));
const to = flow.findIndex((s) => s.t === 'Script');
const edges = flow.slice(1).map((s, i) => {
  const a = flow[i],
    y1 = yOf(i) + H,
    y2 = yOf(i + 1),
    m = (y1 + y2) / 2;
  return { d: `M${mid(a.you)} ${y1} V${m} H${mid(s.you)} V${y2 - 2}`, label: i === back ? 'accept the draft' : '' };
});
const tabs = [
  { id: 'board', label: 'Board' },
  { id: 'stages', label: 'Stages' },
  { id: 'pipeline', label: 'Pipeline' },
  { id: 'artifacts', label: 'Artifacts' },
  { id: 'services', label: 'External services' },
  { id: 'path', label: 'Your path' },
  { id: 'flow', label: 'Every step' },
  { id: 'objects', label: 'Objects' },
  { id: 'sitemap', label: 'Site map' },
  { id: 'plans', label: 'Plans 1 to 4' },
];
const fig = { width: 780, height: yOf(flow.length) };
---

<Base title="Admin" noindex>
  <svg aria-hidden="true" width="0" height="0" class="absolute">
    <symbol id="adm-youtube" viewBox="0 0 16 16">
      <rect x="1" y="3" width="14" height="10" rx="3.5" fill="currentColor"></rect>
      <path d="M6.6 5.8v4.4L10.4 8z" style="fill: var(--card)"></path>
    </symbol>
    <symbol id="adm-key" viewBox="0 0 16 16">
      <circle cx="5" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
      <path d="M8 8h6.5M12 8v2.5M14 8v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
    </symbol>
    <symbol id="adm-api" viewBox="0 0 16 16">
      <path
        d="M5.5 3 1.5 8l4 5M10.5 3l4 5-4 5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </symbol>
    <symbol id="adm-cloud" viewBox="0 0 16 16">
      <path
        d="M4.5 13a3 3 0 0 1-.4-6 4 4 0 0 1 7.7-1 3.5 3.5 0 0 1 .2 7z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"></path>
    </symbol>
    <symbol id="adm-voice" viewBox="0 0 16 16">
      <rect x="5.5" y="1.5" width="5" height="8" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
      <path
        d="M3 7.5a5 5 0 0 0 10 0M8 12.5v2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"></path>
    </symbol>
    <symbol id="adm-globe" viewBox="0 0 16 16">
      <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
      <path
        d="M1.5 8h13M8 1.5c-3.5 4-3.5 9 0 13M8 1.5c3.5 4 3.5 9 0 13"
        fill="none"
        stroke="currentColor"
        stroke-width="1.1"></path>
    </symbol>
  </svg>

  <header>
    <h1 class="text-display font-semibold">Admin</h1>
    <p class={`mt-2 max-w-prose ${small}`}>Dev server only: nothing here is part of the built site.</p>
  </header>

  <TabBar tabs={tabs} label="Admin sections" />

  <Board />

  <section id="services" class="mt-6" aria-labelledby="services-h">
    <h2 id="services-h" class="text-title font-semibold">External services</h2>
    <p class={`mt-1 max-w-prose ${small}`}>
      Where the channels, the upload credentials, the API, the release voice and the hosting are managed. Links open in
      a new tab; the frequent ones are first and in bold. Credentials live in <code>.env</code> and <code
        >.secrets/</code
      >, never here.
    </p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        serviceGroups.map((g, i) => (
          <section class="rounded-lg border bg-card p-3 text-card-foreground" aria-labelledby={`service-${i}`}>
            <h3 id={`service-${i}`} class={`${row} font-medium`}>
              <svg class={ico} aria-hidden="true">
                <use href={`#adm-${g.icon}`} />
              </svg>
              {g.title}
            </h3>
            {g.ids.length > 0 && (
              <dl class={`mt-1 ${small} text-xs`}>
                {g.ids.map((id) => (
                  <div>
                    <dt class="inline">{id.label}:</dt> <dd class="inline font-mono break-all">{id.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            <ul class="mt-2 grid gap-1 text-sm">
              {g.links.map((l) => (
                <li>
                  <a href={l.url} target="_blank" rel="noopener noreferrer" class={l.primary ? 'font-semibold' : ''}>
                    {l.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>{' '}
                  <span class={small}>{l.d}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section id="path" class="mt-6" aria-labelledby="path-h">
    <h2 id="path-h" class="text-title font-semibold">Your path: one story, found to posted</h2>
    <PathDiagram />
  </section>

  <section id="flow" class="mt-6" aria-labelledby="flow-h">
    <h2 id="flow-h" class="text-title font-semibold">Every step of the workflow</h2>
    <p class={`mt-1 max-w-prose ${small}`}>
      The full list behind Your path: what you do, and what the agents and CLIs do between your steps. A red row on the
      board means /produce stopped (a revision limit, a story that left the list, a <code>stop:</code> step): fix what it
      names and paste the same prompt again.
    </p>
    <svg
      class="mt-4 w-full max-w-3xl"
      viewBox={`0 0 ${fig.width} ${fig.height}`}
      role="img"
      aria-labelledby="workflow-title"
    >
      <title id="workflow-title">
        Workflow from sources to a published video, your steps on the left, the AI's on the right
      </title>
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" style="fill: var(--muted-foreground)"></path>
        </marker>
      </defs>
      <g style="font-weight: 600; font-size: 13px; fill: var(--muted-foreground); letter-spacing: 0.08em">
        <text x={mid(true)} y="20" text-anchor="middle">YOU</text>
        <text x={mid(false)} y="20" text-anchor="middle">AI AND CLIS</text>
      </g>
      <g style="fill: none; stroke: var(--muted-foreground); stroke-width: 1.5">
        {edges.map((e) => <path d={e.d} marker-end="url(#arrow)" />)}
        <path
          d={`M${xOf(true)} ${yOf(back) + H / 2} H${LOOP} V${yOf(to) + H / 2} H${xOf(false) - 2}`}
          stroke-dasharray="5 4"
          marker-end="url(#arrow)"></path>
      </g>
      {
        flow.map((s, i) => (
          <g>
            <rect
              x={xOf(s.you)}
              y={yOf(i)}
              width={W}
              height={H}
              rx="8"
              stroke-dasharray={s.planned ? '5 4' : undefined}
              style={`fill: var(${s.you ? '--accent' : '--card'}); stroke: var(--border); stroke-width: 1.5`}
            />
            <text
              x={xOf(s.you) + 12}
              y={yOf(i) + 22}
              style="font-size: 14px; font-weight: 600; fill: var(--foreground)"
            >
              {s.t}
            </text>
            {s.d.map((line, j) => (
              <text
                x={xOf(s.you) + 12}
                y={yOf(i) + 41 + j * 15}
                style="font-size: 11.5px; fill: var(--muted-foreground)"
              >
                {line}
              </text>
            ))}
          </g>
        ))
      }
      <g style="font-size: 12px; fill: var(--muted-foreground)">
        {
          edges.map(
            (e, i) =>
              e.label && (
                <text x={mid(true) + 8} y={yOf(i + 1) - 15}>
                  {e.label}
                </text>
              ),
          )
        }
        <text x={LOOP + 6} y={yOf(to) + H / 2 - 6}>send back with notes</text>
      </g>
    </svg>
  </section>

  <section id="objects" class="mt-6" aria-labelledby="objects-h">
    <h2 id="objects-h" class="text-title font-semibold">The objects and how they relate</h2>
    <ObjectsDiagram />
  </section>

  <section id="sitemap" class="mt-6" aria-labelledby="sitemap-h">
    <h2 id="sitemap-h" class="text-title font-semibold">The site: what links where, and why</h2>
    <SiteMapDiagram />
  </section>

  <section id="plans" class="mt-6" aria-labelledby="plans-h">
    <h2 id="plans-h" class="text-title font-semibold">What plans 1 to 4 added</h2>
    <PlansDiagram />
  </section>
</Base>
