---
// Every object the repo keeps, the file that holds it and how it points at the next one, laid out in the columns the
// work moves through (proposals, identity, research, stories, script stage, video, publishing, operations). The data
// is src/admin/objects.ts (one source for the diagram, the tables and tests/admin-reference.test.ts); a new object is
// one entry there and, if it points somewhere, one edge. Each box links to its owner module in the catalog below; the
// tables under the diagram give each object's owner, writer, validity and file, then the content graph's view of the
// same objects (src/modules/website/content-graph.ts).
import { type Box, cols, edges, moduleCatalog } from './objects';
const modules = moduleCatalog();
const W = 196,
  H = 66,
  GAP = 28, // between columns
  ROW = 92,
  TOP = 44,
  LEFT = 8;
const pos = new Map<string, { x: number; y: number; col: number; row: number }>();
cols.forEach((c, ci) =>
  c.boxes.forEach((b, ri) => pos.set(b.id, { x: LEFT + ci * (W + GAP), y: TOP + ri * ROW, col: ci, row: ri })),
);
const box = (id: string) => {
  const b = pos.get(id);
  if (!b) throw new Error(`ObjectsDiagram: no box ${id}`);
  return b;
};
// An edge between columns leaves the right side and enters the left side, with its elbow in the gutter; one that skips a
// column runs over the top of the boxes. Inside a column, adjacent boxes are joined by a short vertical, others by a
// run down the column's left edge. The label sits beside the elbow or the vertical run.
const paths = edges.map((e) => {
  const a = box(e.from),
    b = box(e.to);
  if (a.col === b.col) {
    const down = b.row > a.row;
    if (Math.abs(b.row - a.row) === 1) {
      const y1 = down ? a.y + H : a.y,
        y2 = down ? b.y - 3 : b.y + H + 3;
      const x = a.x + W / 2 + (down ? -40 : 40);
      return { d: `M${x} ${y1} V${y2}`, lx: x + 6, ly: (y1 + y2) / 2 + 4, label: e.label, anchor: 'start' };
    }
    const y1 = a.y + H - 12,
      y2 = b.y + 12,
      x = a.x - 10;
    return {
      d: `M${a.x} ${y1} H${x} V${y2} H${a.x - 3}`,
      lx: x - 4,
      ly: (y1 + y2) / 2 + 4,
      label: e.label,
      anchor: 'end',
    };
  }
  const x1 = a.x + W,
    x2 = b.x - 3,
    y1 = a.y + H / 2,
    y2 = b.y + H / 2;
  if (b.col === a.col + 1) {
    const gx = a.x + W + GAP / 2;
    return { d: `M${x1} ${y1} H${gx} V${y2} H${x2}`, lx: gx, ly: y2 - 6, label: e.label, anchor: 'middle' };
  }
  // a skip: out to the gutter, up over the headers' baseline, across, down the gutter next to the target
  const gx = a.x + W + GAP / 2 + 5,
    fx = b.x - GAP / 2 - 5,
    top = TOP - 8;
  return {
    d: `M${x1} ${y1} H${gx} V${top} H${fx} V${y2} H${x2}`,
    lx: fx,
    ly: y2 - 6,
    label: e.label,
    anchor: 'middle',
  };
});
const width = LEFT * 2 + cols.length * W + (cols.length - 1) * GAP;
const height = TOP + Math.max(...cols.map((c) => c.boxes.length)) * ROW + 8;

const graph = [
  ['institution', 'inst:<key>', 'commissions in site.ts', '/commissions/<key>/'],
  ['inquiry', '<topic>', 'report.json label', '/<topic>/'],
  ['story (matter)', '<topic>/<story-id>', 'stories.json', '/<topic>/<story slug>/'],
  ['video', '<topic>/<story-id>#youtube', 'publish.json', 'its watch URL once live'],
  ['short', '<topic>/<story-id>#short:<slug>', 'publish.json', 'its watch URL once live'],
  ['article', '<topic>/<story-id>#article', 'article-release.json', 'matter page #article'],
  ['chart', '<story slug>/<scene-id>', 'a storyboard chart an article figures', 'matter page #article'],
  ['dataset', 'data:<topic>/<id>', 'topics/<topic>/data/<id>.json', '/<topic>/data/#<id>'],
  ['tool', 'tool:<id>', 'src/tools/ registry', 'matter page #tool'],
];
// The words a person meets on the pages, the board and the ledger, by the object they describe: each row is one
// closed set of values and what it means. Keep it in step with the type it names.
const vocab: { obj: string; t: string; file: string; v: [string, string][] }[] = [
  {
    obj: 'Source',
    t: 'kind and stance',
    file: 'topics.ts',
    v: [
      ['video, post', 'what was examined: a transcript or a page, scored for how it stands up'],
      ['study', 'a document recorded through record-sources whose verdicts decide claims; never scored'],
      ['asserts, denies', 'the stance a source takes on a claim; denying a wrong claim counts as right'],
    ],
  },
  {
    obj: 'Claim',
    t: 'verdict, confidence, decided by',
    file: 'batches.ts (VERDICTS), shared/evidence-gate.ts (STRONG)',
    v: [
      ['right, wrong, partly', 'the effective verdict; partly is true only under conditions'],
      ['untestable, unknown', 'no verdict can be given, or none yet; these carry no confidence'],
      [
        'confidence 0 to 1',
        'how sure the verdict is; an AI guess is at most 0.5; a study overrides a guess only when at least as confident',
      ],
      ['decided by', 'the study that decides it, or nothing when the AI guess still stands'],
    ],
  },
  {
    obj: 'Claim (public)',
    t: 'finding label',
    file: 'finding-label.ts',
    v: [
      ['Verified claim', 'a study decided it, right or wrong, at 0.75 or more'],
      ['Qualified claim', 'the verdict is partly: true only under conditions'],
      ['Unresolved claim', 'a study decided it under 0.75: studied but not settled'],
      ['Reported claim', 'no study decided it: what the videos and posts say, nothing more'],
    ],
  },
  {
    obj: 'Public record',
    t: 'exhibit, revision',
    file: 'public-record.ts',
    v: [
      ['exhibit', 'a source’s number in the inquiry, given once and never renumbered'],
      ['revision', 'a claim whose label or verdict changed, with the date and a note a person wrote'],
    ],
  },
  {
    obj: 'Story',
    t: 'kind (the id prefix; five drafters)',
    file: 'stories.ts',
    v: [
      ['contradicted', 'a claim the videos make that the studies judge wrong'],
      ['conflict', 'why do studies disagree? two confident, opposite answers'],
      ['surprise', 'a study overturned the AI guess'],
      ['gap', 'a widely repeated claim nobody has checked'],
      ['decision', 'a practical question answered by a group of claims (a recap group)'],
    ],
  },
  {
    obj: 'Story',
    t: 'readiness and chain',
    file: 'stories.ts (Readiness)',
    v: [
      ['needs-research', 'essential evidence missing; the board names it'],
      [
        'needs-review',
        'a person settles listed points in story-review.json; a story with more than one claim is never ready without a review',
      ],
      ['ready', 'every claim verified for its sentence; may be produced'],
      ['rejected', 'pruned by the review; shown as parked'],
      [
        'chain, partOf',
        'one video answers up to three questions; a follow-up is partOf the first and is never produced on its own',
      ],
    ],
  },
  {
    obj: 'Decision',
    t: 'production.json',
    file: 'production.ts',
    v: [['queued, parked', 'produce this next, or set it aside with a note; the only hand-written planning input']],
  },
  {
    obj: 'Production',
    t: 'stage',
    file: 'production.ts (PRODUCTION_STAGES)',
    v: [
      [
        'package, script, validate, review, storyboard, graphics, lock',
        'the script stage: the first artifact missing or not current is the stage',
      ],
      [
        'locked, video, rendered, scored, article, packaged',
        'release.json written; a segment rendered; every scene passes QA; the soundtrack mixed; the article released; the review package made',
      ],
      [
        'health: done, current, stale, blocked, missing, pending',
        'per artifact: current means re-running the library reproduces the file',
      ],
    ],
  },
  {
    obj: 'Production',
    t: 'halt kind',
    file: 'production.ts (HaltKind)',
    v: [
      ['missing, stale', 'run the command the step names'],
      ['blocking-findings, review-findings, review-pending', 'a writer revises, or a reviewer judges'],
      ['revision-limit', 'three revisions spent: /produce stops; a person authorises a corrective pass'],
      [
        'needs-evidence, needs-graphics, graphics-review, render-check, storyboard-blocked',
        'an evidence agent, a graphics builder, a visual reviewer, or a check to fix',
      ],
      [
        'lock, qa-failed, story-left, published',
        'the lock refused; QA failed; the story left the list; the video is live, nothing rebuilds it',
      ],
      ['no-institution', 'no institution claims the topic: a person adds it to commissions in src/config/site.ts'],
      [
        'look-stale',
        'a packaged build drawn with an older kit or theme: a person runs video final when the video nears publication',
      ],
    ],
  },
  {
    obj: 'Board',
    t: 'column (who acts next)',
    file: 'production.ts (COLUMNS)',
    v: [
      ['needs-research, needs-review, ready', 'the story’s readiness; ready offers /produce or npm run run -- story'],
      [
        'producing, article, draft-review, your-review',
        'the run is on it; the article is owed; a draft build awaits a review; the release package is made',
      ],
      [
        'uploaded, changes-requested, approved, shorts, scheduled, published',
        'the ledger’s state of the main output; shorts: an approved video waits for its Shorts',
      ],
      ['parked', 'the decision, or a rejected story'],
    ],
  },
  {
    obj: 'Build',
    t: 'kind and clearance',
    file: 'build-report.ts',
    v: [
      ['draft build', 'the edge voice: review only; accepting it runs video final'],
      ['release build', 'the Azure voice under commercial terms: can be approved and published'],
      [
        'clearance: narration, music, publishable',
        'the voice licence and each composition’s cleared flag; a passing build never sets either',
      ],
    ],
  },
  {
    obj: 'Article',
    t: 'state',
    file: 'production.ts (ArticleState)',
    v: [
      [
        'none, writing, review, blocked',
        'not started; a writer owes it; a reviewer owes it; a blocking finding (the article stage until released)',
      ],
      ['released', 'article-release.json is what the site shows'],
      ['changed, stale', 'the text changed since release (correct); a cited finding was revised (correct or reaffirm)'],
    ],
  },
  {
    obj: 'Ledger',
    t: 'output kind and status',
    file: 'publish.ts (OutputStatus)',
    v: [
      [
        'youtube-video, youtube-short',
        'the main output and a Short derived from it; anything else (post, blog-post) uses the generic flow',
      ],
      [
        'not-uploaded, uploaded, approved, changes-requested',
        'before launch: the person’s decisions on a build, each binding the build and the title',
      ],
      ['scheduled, published', 'go-live at a time, or now; a schedule stands until unpublished'],
      [
        'metadata-behind, build-behind',
        'the title, tags or thumbnail changed since sent (push); a newer build is packaged (upload)',
      ],
      ['retracted', 'withdrawn; nothing to do'],
    ],
  },
];
const small = 'text-sm text-muted-foreground';
---

<p class={`mt-1 max-w-prose ${small}`}>
  Each box is one kind of object and the file that holds it, in the column of the stage that makes it. A gold box is one
  you write by hand; everything else is written by a CLI or an agent and is derived (never hand-edited). Arrows read as
  "from, label, to": a verdict <em>judges</em> a claim; evidence belongs to the claim, not the source, so a new source never
  re-judges old claims.
</p>
<div class="mt-4 overflow-x-auto">
  <svg class="w-full min-w-[110rem]" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="objects-title">
    <title id="objects-title">
      The objects of the repo and their relations, from institution and topic through claims, stories, scripts, video
      builds and the publishing ledger
    </title>
    <defs>
      <marker id="obj-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" style="fill: var(--muted-foreground)"></path>
      </marker>
    </defs>
    <g style="font-weight: 600; font-size: 13px; fill: var(--muted-foreground); letter-spacing: 0.08em">
      {
        cols.map((c, i) => (
          <g>
            <text x={LEFT + i * (W + GAP)} y="16">
              {c.title.toUpperCase()}
            </text>
            <text x={LEFT + i * (W + GAP)} y="31" style="font-weight: 400; font-size: 10.5px; letter-spacing: 0">
              {c.dir}
            </text>
          </g>
        ))
      }
    </g>
    <g style="fill: none; stroke: var(--muted-foreground); stroke-width: 1.3">
      {paths.map((p) => <path d={p.d} marker-end="url(#obj-arrow)" />)}
    </g>
    {
      cols.flatMap((c) =>
        c.boxes.map((b) => {
          const p = box(b.id);
          return (
            <a href={`#module-${b.owner}`} aria-label={`${b.t}: owned by ${b.owner}`}>
              <rect
                x={p.x}
                y={p.y}
                width={W}
                height={H}
                rx="7"
                style={`fill: var(${b.you ? '--accent' : '--card'}); stroke: var(--border); stroke-width: 1.5`}
              />
              <text x={p.x + 10} y={p.y + 20} style="font-size: 13px; font-weight: 600; fill: var(--foreground)">
                {b.t}
              </text>
              {b.d.map((line, j) => (
                <text x={p.x + 10} y={p.y + 37 + j * 13} style="font-size: 10px; fill: var(--muted-foreground)">
                  {line}
                </text>
              ))}
            </a>
          );
        }),
      )
    }
    <g style="font-size: 10.5px; fill: var(--foreground); font-style: italic">
      {
        paths.map((p) => (
          <text
            x={p.lx}
            y={p.ly}
            text-anchor={p.anchor}
            style="paint-order: stroke; stroke: var(--background); stroke-width: 3px"
          >
            {p.label}
          </text>
        ))
      }
    </g>
  </svg>
</div>

<h3 class="mt-8 font-semibold">Each object: owner, writer, validity, file</h3>
<p class={`mt-1 max-w-prose ${small}`}>
  The same boxes as a table. The owner is the module whose code validates and changes the object; the writer is the CLI,
  agent or person that writes it; the validity rule is what makes a file of that kind acceptable. Only objects that
  exist are listed.
</p>
<div class="mt-3 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-xs text-muted-foreground uppercase">
      <tr>
        <th class="py-1 pr-3 font-medium">Object</th>
        <th class="py-1 pr-3 font-medium">Owner</th>
        <th class="py-1 pr-3 font-medium">Written by</th>
        <th class="py-1 pr-3 font-medium">Valid when</th>
        <th class="py-1 font-medium">File</th>
      </tr>
    </thead>
    <tbody>
      {
        cols.flatMap((c) =>
          c.boxes.map((b: Box) => (
            <tr class="border-t align-top" id={`object-${b.id}`}>
              <th scope="row" class="py-1 pr-3 text-left font-medium">
                {b.t}
                <div class="text-[11px] font-normal text-muted-foreground">{c.title}</div>
              </th>
              <td class="py-1 pr-3">
                <a class="text-primary" href={`#module-${b.owner}`}>
                  {b.owner}
                </a>
              </td>
              <td class="py-1 pr-3 text-muted-foreground">{b.writer}</td>
              <td class="py-1 pr-3 text-muted-foreground">{b.valid}</td>
              <td class="py-1 font-mono text-xs">{b.file}</td>
            </tr>
          )),
        )
      }
    </tbody>
  </table>
</div>

<h3 class="mt-8 font-semibold">Modules</h3>
<p class={`mt-1 max-w-prose ${small}`}>
  Every implemented module (a folder under <code>src/modules/</code>), with its responsibility (its README's first
  paragraph), the paths it owns (<code>src/modules/README.md</code>), its CLI and briefs, the names other capabilities
  may read through its <code>index.ts</code> (<code>tests/boundaries.json</code>) and the objects it owns. Shared and
  orchestration stand apart from the domain modules: shared holds contracts and io, orchestration holds derived state,
  routing and, since Milestone 2, scheduling and execution; neither owns content.
</p>
<div class="mt-3 grid gap-3 lg:grid-cols-2">
  {
    modules.map((m) => (
      <article
        id={`module-${m.name}`}
        class:list={[
          'rounded-lg border p-3 text-card-foreground',
          m.kind === 'module' ? 'bg-card' : 'border-l-4 border-l-primary bg-card',
        ]}
      >
        <h4 class="font-semibold">
          {m.name}
          <span class="ml-2 font-mono text-[11px] font-normal text-muted-foreground uppercase">{m.kind}</span>
        </h4>
        <p class={`mt-1 ${small}`}>{m.responsibility}</p>
        <dl class="mt-2 grid gap-1 text-xs">
          <div>
            <dt class="inline font-medium">Paths:</dt> <dd class="inline font-mono">{m.paths || m.readme}</dd>
          </div>
          {m.cli && (
            <div>
              <dt class="inline font-medium">CLI:</dt> <dd class="inline font-mono">{m.cli}</dd>
            </div>
          )}
          {m.briefs && (
            <div>
              <dt class="inline font-medium">Briefs:</dt> <dd class="inline font-mono">{m.briefs}</dd>
            </div>
          )}
          <div>
            <dt class="inline font-medium">Read API:</dt>{' '}
            <dd class="inline font-mono">
              {m.readApi.length ? m.readApi.join(', ') : 'none (read through its CLI and files)'}
            </dd>
          </div>
          <div>
            <dt class="inline font-medium">Objects:</dt>{' '}
            <dd class="inline">
              {m.objects.length
                ? m.objects.map((b, i) => (
                    <>
                      {i > 0 && ', '}
                      <a class="text-primary" href={`#object-${b.id}`}>
                        {b.t}
                      </a>
                    </>
                  ))
                : 'none of its own'}
            </dd>
          </div>
          <div>
            <dt class="inline font-medium">Docs:</dt> <dd class="inline font-mono">{m.readme}</dd>
          </div>
        </dl>
      </article>
    ))
  }
</div>

<h3 class="mt-8 font-semibold">The same objects as the site sees them: the content graph</h3>
<p class={`mt-1 max-w-prose ${small}`}>
  <code>src/modules/website/content-graph.ts</code> rebuilds this graph at every build from the files above and <code
    >urlOf</code
  >
  is the only way a page, a description or a package makes a link (from an id, never a title). Edges: publishes (institution
  to inquiry), in (story to inquiry), partOf (a chained question to its first), madeFrom (video, Short or article to its story),
  derivedFrom (Short to video), cites (article to chart or dataset), uses (story to tool), shares-claims (story to story,
  weighted).
</p>
<div class="mt-3 overflow-x-auto">
  <table class="w-full max-w-4xl text-sm">
    <thead class="text-left text-xs text-muted-foreground uppercase">
      <tr>
        <th class="py-1 pr-3 font-medium">Node</th>
        <th class="py-1 pr-3 font-medium">Id</th>
        <th class="py-1 pr-3 font-medium">Built from</th>
        <th class="py-1 font-medium">Its link (urlOf)</th>
      </tr>
    </thead>
    <tbody>
      {
        graph.map((r) => (
          <tr class="border-t">
            <td class="py-1 pr-3 font-medium">{r[0]}</td>
            <td class="py-1 pr-3 font-mono text-xs">{r[1]}</td>
            <td class="py-1 pr-3 text-muted-foreground">{r[2]}</td>
            <td class="py-1 font-mono text-xs">{r[3]}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<h3 class="mt-8 font-semibold">The words on the pages, by object</h3>
<p class={`mt-1 max-w-prose ${small}`}>
  Every closed set of values a person meets, and what each means. The finding label is the only one the public sees on a
  claim; it is computed from the verdict and its confidence, never judged on its own.
</p>
<div class="mt-3 overflow-x-auto">
  <table class="w-full max-w-5xl text-sm">
    <thead class="text-left text-xs text-muted-foreground uppercase">
      <tr>
        <th class="py-1 pr-3 font-medium">Object</th>
        <th class="py-1 pr-3 font-medium">Values</th>
        <th class="py-1 font-medium">Meaning</th>
      </tr>
    </thead>
    <tbody>
      {
        vocab.flatMap((g) =>
          g.v.map((row, i) => (
            <tr class={`align-top ${i === 0 ? 'border-t' : ''}`}>
              <th scope="row" class="py-1 pr-3 text-left font-medium">
                {i === 0 && (
                  <>
                    {g.obj}: {g.t}
                    <div class="font-mono text-[11px] font-normal text-muted-foreground">{g.file}</div>
                  </>
                )}
              </th>
              <td class="py-1 pr-3 font-mono text-xs">{row[0]}</td>
              <td class="py-1 text-muted-foreground">{row[1]}</td>
            </tr>
          )),
        )
      }
    </tbody>
  </table>
</div>
