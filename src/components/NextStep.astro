---
// A board item's next move: a button that opens a native popover listing each step as a command to run, a
// prompt to hand an agent, or a manual step. Each block has a Copy button (the only client script here). A story
// with a stage gets the /produce prompt first: start or resume the whole run, or (once packaged) send it back.
import { runPromptOf, sendBackPromptOf, type Step, stepsOf } from '../lib/production';
import type { UploadMetadata } from '../lib/publish';

interface Props {
  id: string;
  next: string;
  topic: string;
  story?: string;
  upload?: UploadMetadata | null; // fills in the YouTube form when a step is the upload
  stage?: string; // the production stage, or 'ready' for a ready story with no production yet
}
const { id, next, topic, story, upload, stage } = Astro.props;
const run: Step[] =
  story && stage
    ? [{ kind: 'prompt', text: stage === 'packaged' ? sendBackPromptOf(topic, story) : runPromptOf(topic, story) }]
    : [];
const steps = [...run, ...stepsOf(next, topic, story)];
const labelOf = (s: Step) =>
  s.kind === 'prompt' && s.text.startsWith('/produce ')
    ? stage === 'packaged'
      ? 'Send it back: paste into Claude Code, add your notes'
      : 'The whole run: paste into Claude Code'
    : LABEL[s.kind];
const isUpload = (s: Step) => !!upload && s.kind === 'do' && s.text.startsWith('upload ');
const fields = upload
  ? [
      ['File', upload.file],
      ['Title', upload.title],
      ['Description', upload.description],
      ...(upload.tags.length ? [['Tags', upload.tags.join(', ')]] : []),
      ...(upload.thumbnail ? [['Thumbnail', `${upload.thumbnail.file} (${upload.thumbnail.sha})`]] : []),
      ['Visibility', 'Private (public only once the build is approved: npm run publish -- approve)'],
      ['Audience', 'No, it is not made for kids'],
    ]
  : [];
const LABEL: Record<Step['kind'], string> = {
  run: 'Run in the repo root',
  prompt: 'Give an agent this prompt',
  do: 'Do',
};
const COPY = 'absolute top-1 right-1 rounded-sm border bg-card px-1.5 py-0.5 text-xs hover:bg-muted';
---

<button
  type="button"
  popovertarget={id}
  class="justify-self-start rounded-sm border px-1.5 py-0.5 text-xs font-medium text-primary hover:bg-muted"
>
  What next?
</button>
<div
  popover
  id={id}
  class="max-h-[calc(100dvh-2rem)] w-[min(40rem,calc(100vw-2rem))] overflow-y-auto rounded-lg border bg-card p-4 text-card-foreground shadow-lg backdrop:bg-black/40"
>
  <div class="mb-3 flex items-baseline justify-between gap-2">
    <h3 class="font-semibold">Next{story ? `: ${story}` : `: ${topic}`}</h3>
    <button
      type="button"
      popovertarget={id}
      popovertargetaction="hide"
      class="rounded-sm border px-1.5 py-0.5 text-xs hover:bg-muted"
    >
      Close
    </button>
  </div>
  <ol class="grid gap-3">
    {
      steps.map((s, i) => (
        <li class="grid gap-1">
          <span class="eyebrow text-muted-foreground">
            {steps.length > 1 ? `${i + 1}. ` : ''}
            {labelOf(s)}
          </span>
          {isUpload(s) ? (
            <>
              <p class="text-sm">{s.text}</p>
              <dl class="grid gap-2">
                {fields.map(([k, v]) => (
                  <div class="grid gap-0.5">
                    <dt class="text-xs text-muted-foreground">{k}</dt>
                    <dd class="relative">
                      <pre
                        class="max-h-48 overflow-auto rounded-md bg-muted p-2 pr-14 font-mono text-xs whitespace-pre-wrap select-all"
                        set:text={v}
                      />
                      <button type="button" data-copy class={COPY}>
                        Copy
                      </button>
                    </dd>
                  </div>
                ))}
              </dl>
            </>
          ) : s.kind === 'do' ? (
            <p class="text-sm">{s.text}</p>
          ) : (
            <div class="relative">
              <pre
                class="overflow-x-auto rounded-md bg-muted p-2 pr-14 font-mono text-xs whitespace-pre-wrap select-all"
                set:text={s.text}
              />
              <button type="button" data-copy class={COPY}>
                Copy
              </button>
            </div>
          )}
        </li>
      ))
    }
  </ol>
</div>

<script>
  document.addEventListener('click', async (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
    const text = b?.parentElement?.querySelector('pre')?.textContent;
    if (!b || text == null) return;
    await navigator.clipboard.writeText(text);
    b.textContent = 'Copied';
    setTimeout(() => (b.textContent = 'Copy'), 1500);
  });
</script>
