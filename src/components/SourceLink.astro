---
import type { SourceView } from '../lib/topics';

interface Props {
  source: SourceView;
}
const { source: s } = Astro.props;
---

{
  s.kind === 'video' ? (
    <svg class="mr-1.5 inline size-[1em] align-[-0.15em] text-muted" viewBox="0 0 16 16" role="img" aria-label="Video">
      <rect x="1" y="3" width="14" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      <path d="M6.5 5.8v4.4L10.3 8z" fill="currentColor" />
    </svg>
  ) : (
    <svg
      class="mr-1.5 inline size-[1em] align-[-0.15em] text-muted"
      viewBox="0 0 16 16"
      role="img"
      aria-label="Blog post"
    >
      <path d="M3.5 1.5h6l3 3v10h-9z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      <path d="M5.5 7.5h5M5.5 10h5M5.5 12.5h3" stroke="currentColor" stroke-width="1.2" />
    </svg>
  )
}<a href={s.href}>{s.title}</a>
