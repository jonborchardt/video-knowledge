---
// The icons are <symbol>s defined once per page by SourceIcons.astro; this only references them.
import type { SourceView } from '../lib/topics';

interface Props {
  source: Pick<SourceView, 'kind' | 'href' | 'title'>;
}
const { source: s } = Astro.props;
const icon = 'mr-1.5 inline size-[1em] align-[-0.15em] text-muted-foreground';
---

<svg class={icon} role="img" aria-label={s.kind === 'video' ? 'Video' : 'Blog post'}>
  <use href={`#icon-${s.kind}`}></use>
</svg><a href={s.href}>{s.title}</a>
