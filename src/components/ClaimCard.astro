---
// One claim, expandable to the sources behind its asserted/denied counts and every verdict recorded on it.
// The chip filter is CSS only (the style block below); the stat-line shortcuts are the script below.
import type { ClaimView } from '../lib/topics';
import { site } from '../config/site';
import SourceLink from './SourceLink.astro';
import VerdictBadge from './VerdictBadge.astro';
import FindingLabel from './FindingLabel.astro';
import { findingLabel } from '../lib/finding-label';
import { revisionLine } from '../lib/public-record';
import { citeHref, citeLines } from '../lib/url';

interface Props {
  claim: ClaimView;
  /** Radio-group scope: the same claim appears in several sections, and radios with one name would act as one group. */
  group: string;
}
const { claim: c, group } = Astro.props;
const decided = c.decidedBy
  ? `decided by study: ${c.decidedBy}${c.studies > 1 ? ` (+${c.studies - 1} more)` : ''}`
  : c.studies
    ? `AI guess stands; ${c.studies} ${c.studies > 1 ? 'studies' : 'study'} as context`
    : 'AI guess only';
const asserts = c.sources.filter((s) => s.stance === 'asserts');
const denies = c.sources.filter((s) => s.stance === 'denies');
// One row per chip: `label` on the chip, `text` on the stat line in the summary.
const chips = [
  { v: 'asserts', label: 'Asserts', text: `asserted ${c.asserted}`, n: asserts.length },
  { v: 'denies', label: 'Denies', text: `denied ${c.denied}`, n: denies.length },
  { v: 'verdict', label: 'Verdicts', text: decided, n: c.verdicts.length },
];
const first = chips.findIndex((f) => f.n);
const slug = c.id.split('/').pop();
const small = 'text-sm text-muted-foreground';
---

<details class="group border-t py-3" data-verdict={c.verdict ?? 'unknown'} data-label={findingLabel(c)} data-claim>
  <summary class="grid cursor-pointer list-none gap-1 [&::-webkit-details-marker]:hidden">
    <span class="flex flex-wrap items-baseline justify-between gap-x-2.5">
      <span>
        <span class="mr-1 inline-block transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
        {c.text}
      </span>
      <span class="flex flex-wrap gap-1.5">
        <FindingLabel label={findingLabel(c)} />
        <VerdictBadge verdict={c.verdict} confidence={c.confidence} />
      </span>
    </span>
    {c.note && <span class:list={[small, 'ml-[1.4em]']}>{c.note}</span>}
    {
      c.revisions.map((r) => (
        <span class:list={[small, 'ml-[1.4em] font-semibold']} data-revised={r.at}>
          {revisionLine(r)}
        </span>
      ))
    }
    <span class="ml-[1.4em] font-mono text-xs text-muted-foreground tabular-nums">
      {
        chips.map((x, i) => (
          <>
            {i > 0 && ' · '}
            {x.n ? (
              <button type="button" class="cursor-pointer hover:text-foreground hover:underline" data-pick={x.v}>
                {x.text}
              </button>
            ) : (
              x.text
            )}
          </>
        ))
      }
    </span>
  </summary>
  <div class="ml-[1.4em]">
    <fieldset class="mt-2 flex flex-wrap gap-1.5">
      <legend class="sr-only">Show</legend>
      {
        chips.map((f, i) => (
          <label
            class:list={[
              'cursor-pointer rounded-full border px-2 py-0.5 font-mono text-xs has-checked:border-foreground has-checked:bg-foreground has-checked:text-background',
              !f.n && 'text-muted-foreground opacity-50',
            ]}
          >
            <input
              type="radio"
              class="sr-only"
              id={`c-${group}-${slug}-${f.v}`}
              name={`c-${group}-${slug}`}
              value={f.v}
              checked={i === first}
              disabled={!f.n}
            />
            {f.label} ({f.n})
          </label>
        ))
      }
    </fieldset>
    <ul class="mt-1 grid gap-2 py-1">
      {
        [...asserts, ...denies].map((s) => (
          <li data-k={s.stance} class="grid gap-0.5 border-t pt-2">
            <span>
              {s.stance === 'denies' && <span class="font-mono text-xs text-muted-foreground">DENIES </span>}
              <SourceLink source={s} /> <span class={small}>({s.channel})</span>
            </span>
            {s.quote && <span class={small}>“{s.quote}”</span>}
          </li>
        ))
      }
      {
        c.verdicts.map((v) => (
          <li data-k="verdict" class="grid gap-0.5 border-t pt-2">
            <span>
              <VerdictBadge verdict={v.verdict} confidence={v.confidence} /> {v.by}
              {v.cite && (
                <>
                  {' '}
                  <a class={small} href={citeHref(site.repo, v.cite)}>
                    lines {citeLines(v.cite)}
                  </a>
                </>
              )}
            </span>
            {v.note && <span class={small}>{v.note}</span>}
          </li>
        ))
      }
    </ul>
  </div>
</details>

<style is:global>
  /* The checked chip decides which rows show: asserting sources, denying sources, or the verdicts. */
  [data-claim]:has([value='asserts']:checked) li:not([data-k='asserts']),
  [data-claim]:has([value='denies']:checked) li:not([data-k='denies']),
  [data-claim]:has([value='verdict']:checked) li:not([data-k='verdict']) {
    display: none;
  }
</style>

<script>
  // Stat-line shortcuts ("denied 6", "decided by study"): open the card on that chip.
  document.addEventListener('click', (e) => {
    const pick = (e.target as HTMLElement).closest<HTMLElement>('[data-pick]');
    const card = pick?.closest<HTMLDetailsElement>('details');
    if (!pick || !card) return;
    card.open = true;
    card.querySelector<HTMLInputElement>(`input[value="${pick.dataset.pick}"]`)!.checked = true;
  });
</script>
