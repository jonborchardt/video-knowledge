---
// One claim, expandable to the sources behind its asserted/denied counts and every verdict recorded on it.
import type { ClaimView } from '../lib/topics';
import { site } from '../config/site';
import SourceLink from './SourceLink.astro';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  claim: ClaimView;
}
const { claim: c } = Astro.props;
const decided = c.decidedBy
  ? `decided by study: ${c.decidedBy}${c.studies > 1 ? ` (+${c.studies - 1} more)` : ''}`
  : c.studies
    ? `AI guess stands; ${c.studies} ${c.studies > 1 ? 'studies' : 'study'} as context`
    : 'AI guess only';
const asserts = c.sources.filter((s) => s.stance === 'asserts');
const denies = c.sources.filter((s) => s.stance === 'denies');
const small = 'text-sm text-muted-foreground';
const h = 'mt-3 mb-1 font-mono text-xs tracking-[.04em] text-muted-foreground uppercase';
// Study citations point at the committed sources text in the repo; GitHub honours the #L10-L24 anchor.
const citeHref = (cite: string) => `${site.repo}/blob/main/${cite}`;
const citeLines = (cite: string) => cite.split('#')[1]?.replace(/L/g, '') ?? '';
---

<details class="group border-t py-3" data-verdict={c.verdict ?? 'unknown'}>
  <summary class="grid cursor-pointer list-none gap-1 [&::-webkit-details-marker]:hidden">
    <div class="flex items-baseline justify-between gap-2.5">
      <p>
        <span class="mr-1 inline-block transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
        {c.text}
      </p>
      <VerdictBadge verdict={c.verdict} confidence={c.confidence} />
    </div>
    {c.note && <p class:list={[small, 'ml-[1.4em]']}>{c.note}</p>}
    <span class="ml-[1.4em] font-mono text-xs text-muted-foreground tabular-nums">
      asserted {c.asserted} · denied {c.denied} · {decided}
    </span>
  </summary>
  <div class="ml-[1.4em]">
    {
      [
        { label: 'Asserted by', list: asserts },
        { label: 'Denied by', list: denies },
      ].map(
        (g) =>
          g.list.length > 0 && (
            <>
              <h4 class={h}>
                {g.label} ({g.list.length})
              </h4>
              <ul class="grid gap-1.5">
                {g.list.map((s) => (
                  <li class="grid gap-0.5">
                    <span>
                      <SourceLink source={s} /> <span class={small}>({s.channel})</span>
                    </span>
                    {s.quote && <span class={small}>“{s.quote}”</span>}
                  </li>
                ))}
              </ul>
            </>
          ),
      )
    }
    {
      c.verdicts.length > 0 && (
        <>
          <h4 class={h}>Verdicts ({c.verdicts.length})</h4>
          <ul class="grid gap-1.5">
            {c.verdicts.map((v) => (
              <li class="grid gap-0.5">
                <span>
                  <VerdictBadge verdict={v.verdict} confidence={v.confidence} /> {v.by}
                  {v.cite && (
                    <>
                      {' '}
                      <a class={small} href={citeHref(v.cite)}>
                        lines {citeLines(v.cite)}
                      </a>
                    </>
                  )}
                </span>
                {v.note && <span class={small}>{v.note}</span>}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</details>
