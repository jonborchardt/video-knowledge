---
import { author, commissions, site } from '../config/site';
import { href } from '../lib/url';
---

<footer class="border-t print:hidden">
  <div
    class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-8 text-sm text-muted-foreground sm:px-6"
  >
    <p>
      <span class="font-medium text-foreground">{site.name}</span>
    </p>
    <ul class="flex flex-wrap gap-x-4 gap-y-2">
      {
        Object.values(commissions).map((c) => (
          <li>
            <a href={c.youtube} rel="me" class="hover:text-foreground" title={c.fullName}>
              YouTube {c.handle}
            </a>
          </li>
        ))
      }
      {
        Object.entries(author.links).map(([label, url]) => (
          <li>
            <a href={url} rel="me" class="hover:text-foreground">
              {label}
            </a>
          </li>
        ))
      }
      <li><a href={site.repo} class="hover:text-foreground">Source</a></li>
      <li><a href={href('/production/')} class="hover:text-foreground">Production</a></li>
    </ul>
    <p class="basis-full text-xs">
      {`${site.motto} ${site.disclosure} © ${new Date().getFullYear()} ${author.name}.`}
    </p>
  </div>
</footer>
