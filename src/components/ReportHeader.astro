---
// The docket that opens an inquiry, a matter and an institution (plan D4): the seal and the trail back to the Record,
// the document kind, the title, and a facts row. Colours come from the theme tokens; the seal from the kit
// (`public/commissions/<brand>.png`, written by `npm run brand`). The default slot sits between the lede and the facts.
import { href } from '../lib/url';
import KindIcon, { type LinkKind } from './KindIcon.astro';

interface Props {
  brand: string;
  kind: string;
  trail: { label: string; href: string }[];
  title: string;
  lede?: string;
  /** A linked fact may name the kind of page it leads to (an icon; the page includes SourceIcons). */
  facts: { term: string; value: string; href?: string; rel?: string; kind?: LinkKind }[];
  revised?: string | null;
  /** The institution page shows its seal large beside the title instead of in the trail. */
  bigSeal?: boolean;
}
const { brand, kind, trail, title, lede, facts, revised, bigSeal } = Astro.props;
const rows = revised ? [...facts, { term: 'Last revised', value: revised }] : facts;
const seal = href(`/commissions/${brand}.png`);
---

<header class="grid gap-4 border-y-4 border-double py-5" data-report-header>
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
    <div class="flex flex-wrap items-center gap-x-1 eyebrow text-muted-foreground">
      {!bigSeal && <img class="size-6" src={seal} alt="" width="256" height="256" />}
      {/* A phone shows only the parent: the full trail wraps there, and re-wraps when the web font swaps in. */}
      {
        trail.map((t, i) => (
          <span class:list={['inline-flex items-center gap-x-1', i < trail.length - 1 && 'max-sm:hidden']}>
            {i > 0 && (
              <span class="max-sm:hidden" aria-hidden="true">
                ·
              </span>
            )}
            <a
              class="inline-flex min-h-6 items-center text-muted-foreground no-underline hover:underline"
              href={t.href}
            >
              {t.label}
            </a>
          </span>
        ))
      }
    </div>
    <div class="flex items-center gap-3">
      <div class="eyebrow text-gold">{kind}</div>
      <slot name="stamp" />
    </div>
  </div>
  <div class="flex items-center gap-4">
    {bigSeal && <img class="size-20 shrink-0" src={seal} alt="" width="256" height="256" />}
    <h1 class="text-display font-bold text-balance">{title}</h1>
  </div>
  {lede && <p class="max-w-prose text-lg text-muted-foreground">{lede}</p>}
  <slot />
  <dl
    class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 border-t pt-3 font-mono text-xs text-muted-foreground sm:grid-cols-[auto_1fr_auto_1fr]"
  >
    {
      rows.map((f) => (
        <>
          <dt class="uppercase">{f.term}</dt>
          <dd class="text-foreground">
            {f.href ? (
              <>
                {f.kind && <KindIcon kind={f.kind} class="mr-1 text-muted-foreground" />}
                <a href={f.href} rel={f.rel}>
                  {f.value}
                </a>
              </>
            ) : (
              f.value
            )}
          </dd>
        </>
      ))
    }
  </dl>
</header>
