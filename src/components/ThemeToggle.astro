---
/**
 * Theme toggle, as on the blog. Plain <script>, no hydration: it's a single button.
 * Cycles: system → light → dark → system. Persists to localStorage("theme").
 * The pre-paint script in Base.astro sets `html[data-theme]`; CSS below picks the icon from it,
 * so the right icon shows before this script runs.
 */
const icon = 'h-3.5 w-3.5';
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex h-7 w-7 items-center justify-center rounded-sm text-muted-foreground/70 hover:text-foreground"
  aria-label="Theme: system, switch to light"
>
  <svg
    class:list={[icon, 'theme-icon-system']}
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8M12 16v4"></path>
  </svg>
  <svg
    class:list={[icon, 'theme-icon-light']}
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class:list={[icon, 'theme-icon-dark']}
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style is:global>
  .theme-icon-system,
  .theme-icon-light,
  .theme-icon-dark {
    display: none;
  }
  html:not([data-theme]) .theme-icon-system,
  html[data-theme='system'] .theme-icon-system,
  html[data-theme='light'] .theme-icon-light,
  html[data-theme='dark'] .theme-icon-dark {
    display: block;
  }
</style>

<script>
  const KEY = 'theme';
  const order = ['system', 'light', 'dark'] as const;
  type Mode = (typeof order)[number];

  // localStorage throws when storage is blocked (e.g. Safari with cookies off); the toggle then works for the page only.
  const current = (): Mode => {
    let v: string | null = null;
    try {
      v = localStorage.getItem(KEY);
    } catch {
      /* storage blocked */
    }
    return v === 'light' || v === 'dark' ? v : 'system';
  };
  const store = (mode: Mode) => {
    try {
      if (mode === 'system') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, mode);
    } catch {
      /* storage blocked */
    }
  };

  const apply = (mode: Mode) => {
    const dark = mode === 'dark' || (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
    const root = document.documentElement;
    root.classList.toggle('dark', dark);
    root.dataset.theme = mode;
    const next = order[(order.indexOf(mode) + 1) % order.length];
    for (const el of document.querySelectorAll('[data-theme-toggle]')) {
      el.setAttribute('aria-label', `Theme: ${mode}, switch to ${next}`);
    }
  };

  apply(current());
  for (const btn of document.querySelectorAll('[data-theme-toggle]')) {
    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(current()) + 1) % order.length]!;
      store(next);
      apply(next);
    });
  }
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => apply(current()));
</script>
