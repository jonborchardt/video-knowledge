---
// An evidence dataset (src/modules/evidence/datasets.ts) as a table: one column per entry, the cells' display text as the source states it.
import type { DataTable } from '../modules/evidence';
import { pointText } from '../shared/numbers';

interface Props {
  table: DataTable;
  caption?: string;
  dataHref?: string; // the inquiry's data page, linked from the caption (omit on the data page itself)
}
const { table, caption, dataHref } = Astro.props;
---

{
  /* The caption sits above the scroll region so a phone never clips it; the region and the table are named by the
  title (no ids: a dataset may be drawn twice on a page). */
}
<div class="max-w-wide min-w-0">
  <p class="mb-1 text-sm text-muted-foreground">
    {caption ? `${caption} ` : ''}{table.title} ({table.asOf}, retrieved {table.retrieved}).{
      table.note ? ` ${table.note}` : ''
    }
    {dataHref && <a href={dataHref}> All figures in this inquiry.</a>}
  </p>
  <section class="overflow-x-auto" aria-label={table.title} tabindex="0">
    <table class="w-full border-collapse text-sm" aria-label={table.title}>
      <thead>
        <tr class="border-b text-left text-muted-foreground">
          <th scope="col" class="py-2 pr-4 font-medium"><span class="sr-only">Measure</span></th>
          {
            table.columns.map((c) => (
              <th scope="col" class="py-2 pr-4 font-medium">
                {c.label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          table.rows.map((r) => (
            <tr class="border-b">
              <th scope="row" class="py-2 pr-4 text-left font-normal">
                {r.label}
              </th>
              {r.cells.map((c) => (
                <td class="py-2 pr-4 font-mono tabular-nums">{pointText(c)}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</div>
