---
import type { SurpriseView } from '../lib/topics';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  s: SurpriseView;
}
const { s } = Astro.props;
---

<li>
  <strong>{s.text}</strong>{' '}
  <span class="text-sm text-muted-foreground">(said by {s.saidBy})</span>
  <br />
  AI guess: <VerdictBadge verdict={s.prior} confidence={s.priorConfidence} /> · Study: <VerdictBadge
    verdict={s.evidence}
    confidence={s.evidenceConfidence}
  />
  <br />
  <span class="text-sm text-muted-foreground">{s.note} ({s.study})</span>
</li>
