---
// A static chart: one figure with its caption and source. Every label and value is HTML text at the page's sizes, so
// it reads at 375 wide; only the marks (bars, dots) are drawn, as CSS boxes from the storyboard's geometry. Stat
// tiles are a description list; bar, stacked-bar and dot-plot are one row per point (the page draws a stacked-bar as
// one bar per point); waffle and table are an open table. Colours are theme tokens.
import { barGeometry } from '../modules/storyboard';
import type { ChartSpec } from '../shared/types';
import { pointText } from '../shared/numbers';

interface Props {
  spec: ChartSpec;
  caption: string;
  source: string;
  table?: boolean; // false when the page already carries the data as a table
}
const { spec, caption, source, table = true } = Astro.props;
const rows = spec.type === 'bar' || spec.type === 'stacked-bar' || spec.type === 'dot-plot';
// Widths as a share of the track (0-100): the geometry's width over a 100-wide track.
const bars = barGeometry(spec.points, 100, spec.points.length);
const pct = (w: number) => Math.round(w * 10) / 10;
---

<figure class="max-w-wide" data-chart={spec.type}>
  <figcaption class="mb-2 text-sm text-muted-foreground">
    {caption}
    {spec.note && ` ${spec.note}`}
    <span class="block">Source: {source}</span>
  </figcaption>
  {
    spec.type === 'stat-tiles' && (
      <dl class="grid gap-2 sm:grid-cols-2">
        {spec.points.map((p) => (
          <div class="rounded-sm border bg-card px-4 py-3">
            <dt class="text-sm text-muted-foreground">{p.label}</dt>
            <dd class="font-mono text-xl font-bold tabular-nums">{pointText(p)}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    rows && (
      <ul class="grid list-none gap-3 p-0 text-sm">
        {bars.map((b) => (
          <li class="grid gap-1">
            <span>{b.label}</span>
            <span class="flex items-center gap-3">
              <span class="relative h-3 min-w-0 flex-1" aria-hidden="true">
                {spec.type === 'dot-plot' ? (
                  <>
                    <span class="absolute inset-x-0 top-1/2 border-t" />
                    <span
                      class="absolute top-0 size-3 rounded-full bg-primary"
                      style={`left: calc(${pct(b.w)}% - ${(pct(b.w) / 100) * 0.75}rem)`}
                    />
                  </>
                ) : (
                  <span class="block h-3 bg-primary" style={`width: ${pct(b.w)}%`} />
                )}
              </span>
              <span class="shrink-0 font-mono font-bold tabular-nums">{pointText(b)}</span>
            </span>
          </li>
        ))}
      </ul>
    )
  }
  {
    !rows && spec.type !== 'stat-tiles' && table && (
      <table class="border-collapse text-sm">
        <thead>
          <tr class="border-b text-left text-muted-foreground">
            <th scope="col" class="py-1 pr-6 font-medium">
              Measure
            </th>
            <th scope="col" class="py-1 pr-6 font-medium">
              {spec.title ?? 'Value'}
            </th>
          </tr>
        </thead>
        <tbody>
          {spec.points.map((p) => (
            <tr class="border-b">
              <th scope="row" class="py-1 pr-6 text-left font-normal">
                {p.label}
              </th>
              <td class="py-1 pr-6 font-mono tabular-nums">{pointText(p)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</figure>
