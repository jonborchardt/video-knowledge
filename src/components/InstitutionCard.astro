---
// One institution in the directory: its seal, channel, remit, published inquiries and a featured story.
import { type Commission, commissionKey, site } from '../config/site';
import { type Story, storyUrlSlug } from '../lib/stories';
import type { Topic } from '../lib/topics';
import { href } from '../lib/url';

interface Props {
  c: Commission;
  published: Topic[];
  featured: { s: Story; t: Topic } | null;
}
const { c, published, featured } = Astro.props;
const fmt = (n: number) => n.toLocaleString('en-US');
---

<article class="grid gap-4 rounded-lg border bg-card p-5 text-card-foreground sm:p-6">
  <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
    <div class="flex items-center gap-4">
      <img
        class="size-14 shrink-0"
        src={href(`/commissions/${commissionKey(c)}.png`)}
        alt=""
        width="256"
        height="256"
      />
      <div>
        <div class="eyebrow text-muted-foreground">
          {site.name} · {c.ceremonialName !== c.name ? c.ceremonialName : 'Institution'}
        </div>
        <h2 class="mt-1 text-featured font-bold">
          <a class="no-underline hover:underline" href={href(`/commissions/${commissionKey(c)}/`)}>
            {c.name}
          </a>
        </h2>
      </div>
    </div>
    {
      c.youtube ? (
        <a href={c.youtube} rel="me" class="text-sm" title={c.fullName}>
          YouTube {c.handle}
        </a>
      ) : (
        <span class="rounded-sm border border-dashed px-2 py-1 eyebrow text-muted-foreground">Channel coming soon</span>
      )
    }
  </header>
  <p class="max-w-prose text-muted-foreground">{c.remit}</p>
  {
    published.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-[2fr_3fr]">
        <ul class="grid list-none gap-2 p-0">
          {published.map((t) => (
            <li>
              <a
                class="grid grid-cols-[auto_1fr] items-start gap-3 rounded-md border bg-background p-3 no-underline hover:border-primary"
                href={href(`/${t.name}/`)}
              >
                {/* eslint-disable-next-line astro/no-set-html-directive -- glyphs are committed topics/<topic>/glyph.svg files */}
                {t.glyph && <span class="size-9 text-primary [&>svg]:size-full" set:html={t.glyph} />}
                <span class="grid gap-0.5">
                  <span class="font-heading font-bold text-primary">{t.label}</span>
                  <span class="font-mono text-xs text-muted-foreground">
                    {fmt(t.counted)} sources · {fmt(t.claims.length)} claims · {t.studies} studies
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        {featured && (
          <a
            class="grid content-start gap-2 rounded-md border border-dashed p-4 no-underline hover:border-primary"
            href={href(`/${featured.t.name}/${storyUrlSlug(featured.s)}/`)}
          >
            <span class="eyebrow text-muted-foreground">Featured inquiry · {featured.t.label}</span>
            <span class="font-heading text-title font-bold">{featured.s.title}</span>
            <span class="text-sm text-muted-foreground">{featured.s.question}</span>
            <span class="text-sm text-primary">Read the findings</span>
          </a>
        )}
      </div>
    ) : (
      <p class="font-mono text-xs text-muted-foreground">No inquiry published yet.</p>
    )
  }
</article>
