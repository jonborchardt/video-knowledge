---
// Icon definitions, included once per page, so a list's links share paths instead of inlining them: the kinds of
// source (SourceLink) and the kinds of destination a list can mix (KindIcon: a matter, a video, an article, data, a
// tool, an inquiry, an outside page).
---

<svg aria-hidden="true" width="0" height="0" class="absolute">
  <symbol id="icon-video" viewBox="0 0 16 16">
    <rect x="1" y="3" width="14" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
    <path d="M6.5 5.8v4.4L10.3 8z" fill="currentColor"></path>
  </symbol>
  <symbol id="icon-post" viewBox="0 0 16 16">
    <path d="M3.5 1.5h6l3 3v10h-9z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
    <path d="M5.5 7.5h5M5.5 10h5M5.5 12.5h3" stroke="currentColor" stroke-width="1.2"></path>
  </symbol>
  <symbol id="icon-matter" viewBox="0 0 16 16">
    <path d="M3 1.5h10v13H3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
    <circle cx="8" cy="6" r="2" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
    <path d="M5.5 10.5h5M5.5 12.5h5" stroke="currentColor" stroke-width="1.2"></path>
  </symbol>
  <symbol id="icon-article" viewBox="0 0 16 16">
    <path d="M2 2.5h12v11H2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
    <path d="M4.5 5.5h7M4.5 8h7M4.5 10.5h4" stroke="currentColor" stroke-width="1.2"></path>
  </symbol>
  <symbol id="icon-data" viewBox="0 0 16 16">
    <rect x="1.5" y="2.5" width="13" height="11" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
    <path d="M1.5 6h13M1.5 9.5h13M6 2.5v11" stroke="currentColor" stroke-width="1.1"></path>
  </symbol>
  <symbol id="icon-tool" viewBox="0 0 16 16">
    <rect x="3" y="1.5" width="10" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
    <path d="M5 4h6v2.5H5z" fill="currentColor"></path>
    <path d="M5.5 9h1M9.5 9h1M5.5 12h1M9.5 12h1" stroke="currentColor" stroke-width="1.6"></path>
  </symbol>
  <symbol id="icon-inquiry" viewBox="0 0 16 16">
    <path
      d="M1.5 3.5h5l1.5 1.5h6.5v8.5h-13z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"></path>
  </symbol>
  <symbol id="icon-external" viewBox="0 0 16 16">
    <path d="M9 2.5h4.5V7M13.5 2.5 7 9" fill="none" stroke="currentColor" stroke-width="1.4"></path>
    <path d="M11.5 9.5v4h-9v-9h4" fill="none" stroke="currentColor" stroke-width="1.4"></path>
  </symbol>
</svg>
