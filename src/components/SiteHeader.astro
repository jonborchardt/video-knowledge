---
import { site } from '../config/site';
import { href } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
// The seal, inlined (no extra request; theme-independent colours).
import logo from '../assets/logo.svg?raw';

const current = Astro.url.pathname;
const isActive = (path: string) => current.startsWith(href(path));
const nav = import.meta.env.DEV ? [...site.nav, { label: 'Admin', href: '/admin' }] : site.nav;
---

<header class="border-b print:hidden">
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
    <a href={href('/')} class="flex items-center gap-3 no-underline">
      {/* eslint-disable-next-line astro/no-set-html-directive -- the logo is a committed SVG in src/assets */}
      <span class="inline-block h-9 w-9 [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={logo} />
      <span class="grid leading-tight">
        <span class="font-heading text-[1.05rem] font-bold tracking-wide">{site.name}</span>
        <span class="eyebrow text-muted-foreground max-sm:hidden">{site.publicRecord}</span>
      </span>
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-1 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={href(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-sm px-2 py-1 text-muted-foreground no-underline hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li><ThemeToggle /></li>
      </ul>
    </nav>
  </div>
</header>
