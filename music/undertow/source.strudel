// undertow: a restrained documentary bed in D minor at 84 bpm for video-knowledge's MLM video. Every voice is an
// oscillator (no sample pack, no soundfont), so nothing in it carries a sample licence. Five sections, each a reusable
// variation the video mixes under narration (looped on its bar boundary, faded and ducked by the video's own mixer):
//   pulse    the opening: a low drone, a dark pad, a sine pulse that keeps time without a drum
//   active   the pitch: the pulse plus a short bass figure and a quiet arpeggio, still subtle
//   texture  the investigation: pad and drone only, the pulse thinned to a tick, music as room tone
//   motif    the implications: the four-bar motif stated on a glassy triangle over the pad
//   rest     the conclusion: the motif resolves to the root and stops
// One room for everything (superdough's own reverb, no impulse pack). Dynamics are kept narrow on purpose.
const feel = { timingMs: 10, velocity: .06, correlation: 'bar' };
// the drone: a sine on the chord root in octave 2, held a whole bar, bone dry
const drone = (line, o = {}) => ({
  pattern: note('<' + line + '>').s('sine').clip(1.02).attack(.3).release(.8),
  level: .3, space: 0, humanize: feel, ...o,
});
const ROOTS = 'd2 d2 bb1 bb1';
const ROOTS4 = 'd2 bb1 f2 c2';
// the pulse: a soft sine tick on beats two and four, an octave above the drone, no drum in the song
const pulse = (grid, o = {}) => ({
  pattern: note('d4').s('sine').struct(grid).attack(.005).decay(.12).sustain(0).release(.05),
  level: .22, space: .25, position: .15, humanize: feel, ...o,
});
const pad = { patch: 'hollow', brightness: .3, weight: .45, articulation: .15, space: .7, width: .6, density: .5, level: .55, humanize: { ...feel, correlation: 'phrase' } };
const arp = { patch: 'glass', brightness: .4, weight: .3, articulation: .4, space: .6, width: .5, density: .5, register: .6, level: .28, arp: '0 2 1 2', position: -.3 };
const bass = { sound: 'sine', register: .3, weight: .55, brightness: .35, articulation: .55, space: .1, density: .4, level: .9, humanize: feel };
const lead = { sound: 'triangle', patch: 'glass', register: .55, brightness: .4, articulation: .3, space: .55, width: .3, level: .7, position: .1, follow: false, humanize: { ...feel, correlation: 'phrase' } };

song({ cps: .35, key: 'D:minor', seed: 11, saturate: .4, room: { size: 2.4, fade: .12, damping: 3800 } }, [

  section('pulse', 16, { role: 'establish', progression: 'i@2 VI@2',
    raw:  { ...drone(ROOTS) },
    raw2: { ...pulse('~ x ~ x') },
    pad:  { ...pad, enter: 2 },
  }),

  section('active', 16, { role: 'develop', progression: 'i VI iv VII',
    raw:  { ...drone(ROOTS4) },
    raw2: { ...pulse('~ x ~ [x ~ ~ x]') },
    pad:  { ...pad },
    pad2: { ...arp, enter: 4 },
    // the bass figure: root, a step down, the fifth, home; two bars, then it rests
    bass: { ...bass, rhythm: 'x...............|......x.........|..x.............|................', notes: '0 -1 4 0' },
  }),

  section('texture', 16, { role: 'develop', progression: 'i@2 iv@2',
    raw:  { ...drone(ROOTS, { level: .26 }) },
    raw2: { ...pulse('~ ~ ~ x', { level: .14 }) },
    pad:  { ...pad, brightness: .22, density: .35, level: .5 },
  }),

  section('motif', 16, { role: 'develop', progression: 'i VI III VII',
    raw:  { ...drone(ROOTS4) },
    raw2: { ...pulse('~ x ~ x') },
    pad:  { ...pad, brightness: .34 },
    // the motif: root, up a step, a held fourth, down to the second, back to the root; the answer ends on the fifth
    melody: { ...lead, phrase: 4, notes: '[0@2 1@2] [3@3 2] [1@2 0@2] [~@4] [0@2 2@2] [3@3 4] [2@2 1@2] [4@2 ~@2]' },
  }),

  section('rest', 8, { role: 'release', progression: 'iv VI i@2',
    raw:  { ...drone('g2 bb1 d2 d2', { level: .28 }) },
    pad:  { ...pad, brightness: .28, exit: 2 },
    // the last word: the motif slower, ending on the root and holding it
    melody: { ...lead, phrase: 4, level: .65, notes: '[0@2 1@2] [3@3 2] [1@3 -1] [0@4]' },
  }),
])
