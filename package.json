{
  "name": "video-knowledge",
  "private": true,
  "type": "module",
  "description": "What YouTube videos and blog posts claim, checked against the evidence. Topic stores built with the watcher library (../retire-sim/watcher).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "typecheck:ts": "tsc --noEmit",
    "check": "npm run typecheck:ts && npm run lint",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "quality": "tsx src/modules/website/cli-quality.ts",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test",
    "watcher": "node src/modules/evidence/watcher.mjs",
    "evidence": "tsx src/modules/evidence/cli-research.ts",
    "report": "tsx src/modules/evidence/cli-report.ts",
    "record": "node src/modules/evidence/record.mjs",
    "record-sources": "node src/modules/evidence/record-sources.mjs",
    "merge-claims": "node src/modules/evidence/merge-claims.mjs",
    "stories": "tsx src/modules/stories/cli.ts",
    "links": "tsx src/modules/website/cli-links.ts",
    "shorts": "tsx src/modules/shorts/cli.ts",
    "script": "tsx src/modules/script/cli.ts",
    "article": "tsx src/modules/article/cli.ts",
    "video": "tsx src/modules/video/cli.ts",
    "tts-azure": "tsx src/modules/video/tts/azure-worker.ts",
    "packaging": "tsx src/modules/packaging/cli.ts",
    "music": "tsx src/modules/video/cli-music.ts",
    "brand": "tsx src/modules/brand/cli.ts",
    "board": "tsx src/orchestration/board.ts",
    "run": "tsx src/orchestration/run/cli.ts",
    "publish": "tsx src/modules/publishing/cli.ts",
    "social": "tsx src/modules/social/cli.ts",
    "topics": "tsx src/modules/topic-discovery/cli.ts",
    "rehearse": "tsx src/modules/website/cli-rehearse.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@types/mailparser": "3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.536",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "imapflow": "2.10.0",
    "mailparser": "3.14.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "nodemailer": "10.3.1",
    "tailwindcss": "^4.3.3"
  }
}
